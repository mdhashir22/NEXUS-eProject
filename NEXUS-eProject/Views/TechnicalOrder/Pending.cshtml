@model IEnumerable<NEXUS_eProject.Models.Order>

@{
    ViewData["Title"] = "Pending Technical Orders";
    ViewData["PageTitle"] = "Pending Orders";
    Layout = "~/Views/Shared/_TechnicalLayout.cshtml";

    var search = ViewBag.Search as string;
    var connectionType = ViewBag.ConnectionType as string;
}

<div class="tp-page">

    <div class="tp-header">
        <div>
            <span class="tp-eyebrow">
                <i class="bi bi-hourglass-split"></i>
                TECHNICAL OPERATIONS
            </span>

            <h2>Pending Technical Orders</h2>

            <p>
                Retail accepted orders waiting for technical feasibility.
            </p>
        </div>

        <div class="tp-count">
            <span>PENDING</span>
            <strong>@Model.Count()</strong>
        </div>
    </div>

    <div class="tp-filter-card">

        <form method="get"
              asp-controller="TechnicalOrder"
              asp-action="Pending"
              class="tp-filter-form">

            <div class="tp-search">
                <i class="bi bi-search"></i>

                <input type="text"
                       name="search"
                       value="@search"
                       placeholder="Search order, customer or phone..." />
            </div>

            <select name="connectionType"
                    class="tp-select">

                <option value="">All Connection Types</option>

                <option value="Broadband"
                        selected="@(connectionType == "Broadband")">
                    Broadband
                </option>

                <option value="Dial-Up"
                        selected="@(connectionType == "Dial-Up")">
                    Dial-Up
                </option>

                <option value="Telephone/Landline"
                        selected="@(connectionType == "Telephone/Landline")">
                    Telephone / Landline
                </option>

            </select>

            <button class="tp-filter-btn" type="submit">
                <i class="bi bi-funnel"></i>
                Filter
            </button>

            @if (!string.IsNullOrWhiteSpace(search) ||
                 !string.IsNullOrWhiteSpace(connectionType))
            {
                <a asp-controller="TechnicalOrder"
                   asp-action="Pending"
                   class="tp-clear-btn">
                    Clear
                </a>
            }

        </form>

    </div>

    <div class="tp-card">

        <div class="tp-card-header">
            <div>
                <h5>
                    <i class="bi bi-hourglass-split"></i>
                    Waiting for Technical Review
                </h5>

                <span>@Model.Count() order(s) found</span>
            </div>
        </div>

        @if (Model.Any())
        {
            <div class="tp-table-wrap">

                <table class="tp-table">

                    <thead>
                        <tr>
                            <th>ORDER</th>
                            <th>CUSTOMER</th>
                            <th>CONNECTION</th>
                            <th>PLAN</th>
                            <th>SUBMITTED</th>
                            <th>STATUS</th>
                            <th>ACTION</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var order in Model)
                        {
                            <tr>

                                <td>
                                    <strong class="tp-order">
                                        @order.OrderNumber
                                    </strong>
                                </td>

                                <td>
                                    <div class="tp-customer">
                                        <strong>
                                            @(order.Customer?.FullName ?? "-")
                                        </strong>

                                        <span>
                                            @(order.Customer?.Phone ?? "-")
                                        </span>
                                    </div>
                                </td>

                                <td>
                                    @(order.ConnectionType ?? "-")
                                </td>

                                <td>
                                    <div class="tp-customer">
                                        <strong>
                                            @(order.Plan?.PlanName ?? "-")
                                        </strong>

                                        <span>
                                            @(order.Plan?.Speed ?? "-")
                                        </span>
                                    </div>
                                </td>

                                <td>
                                    @order.CreatedAt.ToString("dd MMM yyyy")
                                </td>

                                <td>
                                    <span class="tp-status">
                                        <i class="bi bi-circle-fill"></i>
                                        Retail Accepted
                                    </span>
                                </td>

                                <td>
                                    <div class="tp-actions">

                                        <a asp-controller="TechnicalOrder"
                                           asp-action="Details"
                                           asp-route-id="@order.OrderId"
                                           class="tp-icon-btn"
                                           title="Details">
                                            <i class="bi bi-eye"></i>
                                        </a>

                                        <a asp-controller="TechnicalOrder"
                                           asp-action="CheckFeasibility"
                                           asp-route-id="@order.OrderId"
                                           class="tp-process-btn">

                                            <i class="bi bi-clipboard-check"></i>
                                            Check

                                        </a>

                                    </div>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="tp-empty">

                <i class="bi bi-check2-circle"></i>

                <h5>No Pending Orders</h5>

                <p>
                    There are currently no orders waiting for
                    technical feasibility.
                </p>

            </div>
        }

    </div>

</div>