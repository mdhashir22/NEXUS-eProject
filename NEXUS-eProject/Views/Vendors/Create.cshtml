@model NEXUS_eProject.Models.Vendor

@{
    ViewData["Title"] = "Add Vendor";
    ViewData["PageTitle"] = "Add Vendor";
    ViewData["PageSubtitle"] = "Create a new Nexus vendor";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-heading">

    <div>
        <h2>Add Vendor</h2>
        <p>Add a new vendor to the Nexus system.</p>
    </div>

</div>


<div class="form-card">

    <form asp-action="Create" method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="validation-summary">
        </div>


        <div class="form-section-title">
            Vendor Information
        </div>


        <div class="form-grid">

            <div class="form-group">

                <label asp-for="VendorName">
                    Vendor Name
                </label>

                <input asp-for="VendorName"
                       class="nexus-input"
                       placeholder="Enter vendor name" />

                <span asp-validation-for="VendorName"
                      class="field-error">
                </span>

            </div>


            <div class="form-group">

                <label asp-for="ContactPerson">
                    Contact Person
                </label>

                <input asp-for="ContactPerson"
                       class="nexus-input"
                       placeholder="Enter contact person" />

                <span asp-validation-for="ContactPerson"
                      class="field-error">
                </span>

            </div>


            <div class="form-group">

                <label asp-for="Phone">
                    Phone
                </label>

                <input asp-for="Phone"
                       class="nexus-input"
                       placeholder="Enter phone number" />

                <span asp-validation-for="Phone"
                      class="field-error">
                </span>

            </div>


            <div class="form-group">

                <label asp-for="Email">
                    Email
                </label>

                <input asp-for="Email"
                       type="email"
                       class="nexus-input"
                       placeholder="Enter email address" />

                <span asp-validation-for="Email"
                      class="field-error">
                </span>

            </div>


            <div class="form-group">

                <label asp-for="Address">
                    Address
                </label>

                <input asp-for="Address"
                       class="nexus-input"
                       placeholder="Enter vendor address" />

                <span asp-validation-for="Address"
                      class="field-error">
                </span>

            </div>

        </div>


        <div class="form-footer">

            <a asp-action="Index"
               class="secondary-action">

                <i class="bi bi-arrow-left"></i>
                Cancel

            </a>


            <button type="submit"
                    class="nexus-btn">

                <i class="bi bi-check-lg"></i>
                Save Vendor

            </button>

        </div>

    </form>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}