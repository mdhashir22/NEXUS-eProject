@model NEXUS_eProject.Models.Vendor

@{
    ViewData["Title"] = "Edit Vendor";
    ViewData["PageTitle"] = "Edit Vendor";
    ViewData["PageSubtitle"] = "Update vendor information";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-heading">

    <div>
        <h2>Edit Vendor</h2>
        <p>Update the selected vendor information.</p>
    </div>

</div>


<div class="form-card">

    <form asp-action="Edit" method="post">

        @Html.AntiForgeryToken()

        <input type="hidden"
               asp-for="VendorId" />

        <input type="hidden"
               asp-for="CreatedAt" />


        <div asp-validation-summary="ModelOnly"
             class="validation-summary">
        </div>


        <div class="form-section-title">
            Vendor Information
        </div>


        <div class="form-grid">

            <div class="form-group">

                <label asp-for="VendorName">
                    Vendor Name
                </label>

                <input asp-for="VendorName"
                       class="nexus-input" />

                <span asp-validation-for="VendorName"
                      class="field-error">
                </span>

            </div>


            <div class="form-group">

                <label asp-for="ContactPerson">
                    Contact Person
                </label>

                <input asp-for="ContactPerson"
                       class="nexus-input" />

                <span asp-validation-for="ContactPerson"
                      class="field-error">
                </span>

            </div>


            <div class="form-group">

                <label asp-for="Phone">
                    Phone
                </label>

                <input asp-for="Phone"
                       class="nexus-input" />

                <span asp-validation-for="Phone"
                      class="field-error">
                </span>

            </div>


            <div class="form-group">

                <label asp-for="Email">
                    Email
                </label>

                <input asp-for="Email"
                       type="email"
                       class="nexus-input" />

                <span asp-validation-for="Email"
                      class="field-error">
                </span>

            </div>


            <div class="form-group">

                <label asp-for="Address">
                    Address
                </label>

                <input asp-for="Address"
                       class="nexus-input" />

                <span asp-validation-for="Address"
                      class="field-error">
                </span>

            </div>


            <div class="form-group">

                <label asp-for="IsActive">
                    Status
                </label>

                <select asp-for="IsActive"
                        class="nexus-input">

                    <option value="true">
                        Active
                    </option>

                    <option value="false">
                        Inactive
                    </option>

                </select>

            </div>

        </div>


        <div class="form-footer">

            <a asp-action="Index"
               class="secondary-action">

                <i class="bi bi-arrow-left"></i>
                Cancel

            </a>


            <button type="submit"
                    class="nexus-btn">

                <i class="bi bi-check-lg"></i>
                Update Vendor

            </button>

        </div>

    </form>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}