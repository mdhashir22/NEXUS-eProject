@model IEnumerable<NEXUS_eProject.Models.Connection>

@{
    ViewData["Title"] = "Installations";
    ViewData["PageTitle"] = "Installations";
    Layout = "~/Views/Shared/_TechnicalLayout.cshtml";

    var search = ViewBag.Search as string;

    var ready = Model.Count(c =>
        c.Order?.Status == "Payment Verified");

    var pending = Model.Count(c =>
        c.Order?.Status == "Installation Pending");
}

<div class="ti-page">

    <div class="ti-header">

        <div>
            <span>
                <i class="bi bi-tools"></i>
                TECHNICAL OPERATIONS
            </span>

            <h2>Installations</h2>

            <p>
                Paid and verified connections ready for installation.
            </p>
        </div>

    </div>

    <div class="ti-stats">

        <div class="ti-stat">
            <i class="bi bi-list-task purple"></i>

            <div>
                <span>TOTAL QUEUE</span>
                <strong>@Model.Count()</strong>
            </div>
        </div>

        <div class="ti-stat">
            <i class="bi bi-check-circle blue"></i>

            <div>
                <span>READY</span>
                <strong>@ready</strong>
            </div>
        </div>

        <div class="ti-stat">
            <i class="bi bi-tools orange"></i>

            <div>
                <span>IN PROGRESS</span>
                <strong>@pending</strong>
            </div>
        </div>

    </div>

    <div class="tp-filter-card">

        <form method="get"
              asp-controller="TechnicalInstallation"
              asp-action="Index"
              class="tp-filter-form">

            <div class="tp-search">
                <i class="bi bi-search"></i>

                <input type="text"
                       name="search"
                       value="@search"
                       placeholder="Search account, order or customer..." />
            </div>

            <button type="submit"
                    class="tp-filter-btn">
                Search
            </button>

        </form>

    </div>

    <div class="tp-card">

        <div class="tp-card-header">
            <div>
                <h5>
                    <i class="bi bi-tools"></i>
                    Installation Queue
                </h5>

                <span>
                    @Model.Count() connection(s) awaiting installation
                </span>
            </div>
        </div>

        @if (Model.Any())
        {
            <div class="tp-table-wrap">

                <table class="tp-table">

                    <thead>
                        <tr>
                            <th>ACCOUNT</th>
                            <th>CUSTOMER</th>
                            <th>TYPE</th>
                            <th>PLAN</th>
                            <th>ROUTER</th>
                            <th>ORDER STATUS</th>
                            <th>ACTION</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var connection in Model)
                        {
                            var inProgress =
                                connection.Order?.Status ==
                                "Installation Pending";

                            <tr>

                                <td>
                                    <strong class="tp-order">
                                        @connection.AccountId
                                    </strong>
                                </td>

                                <td>
                                    <div class="tp-customer">
                                        <strong>
                                            @(connection.Customer?.FullName ?? "-")
                                        </strong>

                                        <span>
                                            @(connection.Customer?.Phone ?? "-")
                                        </span>
                                    </div>
                                </td>

                                <td>
                                    @connection.ConnectionType
                                </td>

                                <td>
                                    <div class="tp-customer">
                                        <strong>
                                            @(connection.Plan?.PlanName ?? "-")
                                        </strong>

                                        <span>
                                            @(connection.Plan?.Speed ?? "-")
                                        </span>
                                    </div>
                                </td>

                                <td>
                                    @(connection.RouterSerial ?? "-")
                                </td>

                                <td>
                                    <span class="@(inProgress ? "ti-progress" : "ti-ready")">

                                        <i class="bi bi-circle-fill"></i>

                                        @(connection.Order?.Status ?? "-")

                                    </span>
                                </td>

                                <td>
                                    <a asp-controller="TechnicalInstallation"
                                       asp-action="Details"
                                       asp-route-id="@connection.ConnectionId"
                                       class="tp-process-btn">

                                        <i class="bi bi-tools"></i>
                                        Process

                                    </a>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="tp-empty">

                <i class="bi bi-tools"></i>

                <h5>No Installation Jobs</h5>

                <p>
                    Payment-verified connections will appear here.
                </p>

            </div>
        }

    </div>

</div>