@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    ViewData["Title"] = "Reports";
    ViewData["PageTitle"] = "Reports";
    ViewData["PageSubtitle"] = "Overview of Nexus business activity";
}

<div class="reports-page">

    <!-- Page Heading -->
    <div class="reports-heading">
        <div>
            <h2>Reports</h2>
            <p>Overview of customers, orders, products and connections.</p>
        </div>

        <div class="reports-heading-icon">
            <i class="bi bi-bar-chart-line"></i>
        </div>
    </div>


    <!-- Summary Cards -->
    <div class="reports-stats-grid">

        <!-- Employees -->
        <div class="reports-stat-card reports-stat-purple">

            <div class="reports-stat-top">
                <div class="reports-stat-icon">
                    <i class="bi bi-people"></i>
                </div>

                <span class="reports-stat-badge">
                    <i class="bi bi-person-check"></i>
                    Staff
                </span>
            </div>

            <div class="reports-stat-content">
                <span>Total Employees</span>
                <h3>@ViewBag.TotalEmployees</h3>
            </div>

            <div class="reports-stat-footer">
                <i class="bi bi-people"></i>
                Registered employees
            </div>

        </div>


        <!-- Customers -->
        <div class="reports-stat-card reports-stat-blue">

            <div class="reports-stat-top">
                <div class="reports-stat-icon">
                    <i class="bi bi-person-vcard"></i>
                </div>

                <span class="reports-stat-badge">
                    <i class="bi bi-person"></i>
                    Customers
                </span>
            </div>

            <div class="reports-stat-content">
                <span>Total Customers</span>
                <h3>@ViewBag.TotalCustomers</h3>
            </div>

            <div class="reports-stat-footer">
                <i class="bi bi-person-lines-fill"></i>
                Registered customers
            </div>

        </div>


        <!-- Orders -->
        <div class="reports-stat-card reports-stat-orange">

            <div class="reports-stat-top">
                <div class="reports-stat-icon">
                    <i class="bi bi-cart-check"></i>
                </div>

                <span class="reports-stat-badge">
                    <i class="bi bi-cart"></i>
                    Orders
                </span>
            </div>

            <div class="reports-stat-content">
                <span>Total Orders</span>
                <h3>@ViewBag.TotalOrders</h3>
            </div>

            <div class="reports-stat-footer">
                <i class="bi bi-activity"></i>
                All customer orders
            </div>

        </div>


        <!-- Connections -->
        <div class="reports-stat-card reports-stat-green">

            <div class="reports-stat-top">
                <div class="reports-stat-icon">
                    <i class="bi bi-router"></i>
                </div>

                <span class="reports-stat-badge">
                    <i class="bi bi-wifi"></i>
                    Network
                </span>
            </div>

            <div class="reports-stat-content">
                <span>Total Connections</span>
                <h3>@ViewBag.TotalConnections</h3>
            </div>

            <div class="reports-stat-footer">
                <i class="bi bi-broadcast"></i>
                Customer connections
            </div>

        </div>

    </div>


    <!-- Reports -->
    <div class="row g-4 mt-1">

        <!-- Order Report -->
        <div class="col-lg-6">

            <div class="reports-panel h-100">

                <div class="reports-panel-header">

                    <div class="reports-panel-title">

                        <div class="reports-panel-icon reports-icon-orange">
                            <i class="bi bi-cart-check"></i>
                        </div>

                        <div>
                            <h5>Order Report</h5>
                            <span>Current order status overview</span>
                        </div>

                    </div>

                    <div class="reports-panel-menu">
                        <i class="bi bi-three-dots"></i>
                    </div>

                </div>


                <div class="reports-details-grid">

                    <div class="reports-detail-item reports-detail-pending">

                        <div class="reports-detail-icon">
                            <i class="bi bi-hourglass-split"></i>
                        </div>

                        <div class="reports-detail-text">
                            <span>Pending Orders</span>
                            <strong>@ViewBag.PendingOrders</strong>
                        </div>

                    </div>


                    <div class="reports-detail-item reports-detail-approved">

                        <div class="reports-detail-icon">
                            <i class="bi bi-check-circle"></i>
                        </div>

                        <div class="reports-detail-text">
                            <span>Approved Orders</span>
                            <strong>@ViewBag.ApprovedOrders</strong>
                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- Connection Report -->
        <div class="col-lg-6">

            <div class="reports-panel h-100">

                <div class="reports-panel-header">

                    <div class="reports-panel-title">

                        <div class="reports-panel-icon reports-icon-blue">
                            <i class="bi bi-diagram-3"></i>
                        </div>

                        <div>
                            <h5>Connection Report</h5>
                            <span>Current connection status overview</span>
                        </div>

                    </div>

                    <div class="reports-panel-menu">
                        <i class="bi bi-three-dots"></i>
                    </div>

                </div>


                <div class="reports-details-grid">

                    <div class="reports-detail-item reports-detail-active">

                        <div class="reports-detail-icon">
                            <i class="bi bi-wifi"></i>
                        </div>

                        <div class="reports-detail-text">
                            <span>Active Connections</span>
                            <strong>@ViewBag.ActiveConnections</strong>
                        </div>

                    </div>


                    <div class="reports-detail-item reports-detail-other">

                        <div class="reports-detail-icon">
                            <i class="bi bi-clock-history"></i>
                        </div>

                        <div class="reports-detail-text">
                            <span>Pending / Other</span>
                            <strong>@ViewBag.PendingConnections</strong>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- System Summary -->
    <div class="reports-panel reports-system-panel mt-4">

        <div class="reports-panel-header">

            <div class="reports-panel-title">

                <div class="reports-panel-icon reports-icon-purple">
                    <i class="bi bi-database"></i>
                </div>

                <div>
                    <h5>System Summary</h5>
                    <span>Current Nexus master data</span>
                </div>

            </div>

            <div class="reports-system-status">
                <i class="bi bi-circle-fill"></i>
                System Data
            </div>

        </div>


        <div class="reports-details-grid reports-system-grid">

            <div class="reports-detail-item reports-detail-products">

                <div class="reports-detail-icon">
                    <i class="bi bi-box-seam"></i>
                </div>

                <div class="reports-detail-text">
                    <span>Products</span>
                    <strong>@ViewBag.TotalProducts</strong>
                </div>

            </div>


            <div class="reports-detail-item reports-detail-plans">

                <div class="reports-detail-icon">
                    <i class="bi bi-wifi"></i>
                </div>

                <div class="reports-detail-text">
                    <span>Internet Plans</span>
                    <strong>@ViewBag.TotalPlans</strong>
                </div>

            </div>

        </div>

    </div>

</div>