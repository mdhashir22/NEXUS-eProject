@model IEnumerable<NEXUS_eProject.Models.Plan>

@{
    ViewData["Title"] = "Plans";
    ViewData["PageTitle"] = "Plans";
    ViewData["PageSubtitle"] = "Manage Nexus internet plans";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-heading">

    <div>
        <h2>Plans</h2>
        <p>Manage connection plans, pricing and services.</p>
    </div>

    <a asp-action="Create" class="nexus-btn">
        <i class="bi bi-plus-lg"></i>
        Add Plan
    </a>

</div>


@if (TempData["SuccessMessage"] != null)
{
    <div class="success-alert">
        <i class="bi bi-check-circle-fill"></i>
        <span>@TempData["SuccessMessage"]</span>
    </div>
}


<div class="dashboard-card">

    <div class="card-header">

        <div>
            <h5>Plan List</h5>

            <span>
                @Model.Count() plans registered
            </span>
        </div>

    </div>


    <div class="table-responsive">

        <table class="nexus-table">

            <thead>
                <tr>
                    <th>ID</th>
                    <th>PLAN</th>
                    <th>CONNECTION</th>
                    <th>SPEED</th>
                    <th>DURATION</th>
                    <th>PRICE</th>
                    <th>STATUS</th>
                    <th>ACTIONS</th>
                </tr>
            </thead>


            <tbody>

                @if (Model.Any())
                {
                    foreach (var plan in Model)
                    {
                        <tr>

                            <td>
                                #@plan.PlanId
                            </td>


                            <td>

                                <div class="employee-cell">

                                    <div class="employee-avatar">
                                        @(string.IsNullOrWhiteSpace(plan.PlanName)
                                            ? "P"
                                            : plan.PlanName.Substring(0, 1).ToUpper())
                                    </div>

                                    <div>

                                        <strong>
                                            @plan.PlanName
                                        </strong>

                                        <small>
                                            @plan.CreatedAt.ToString("dd MMM yyyy")
                                        </small>

                                    </div>

                                </div>

                            </td>


                            <td>
                                @plan.ConnectionType
                            </td>


                            <td>
                                @(plan.Speed ?? "N/A")
                            </td>


                            <td>
                                @(plan.Duration ?? "N/A")
                            </td>


                            <td>
                                Rs. @plan.Price.ToString("N2")
                            </td>


                            <td>

                                @if (plan.IsActive)
                                {
                                    <span class="status-badge active">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge inactive">
                                        Inactive
                                    </span>
                                }

                            </td>


                            <td>

                                <div class="table-actions">

                                    <a asp-action="Edit"
                                       asp-route-id="@plan.PlanId"
                                       class="table-action edit"
                                       title="Edit">

                                        <i class="bi bi-pencil"></i>

                                    </a>


                                    <a asp-action="Delete"
                                       asp-route-id="@plan.PlanId"
                                       class="table-action delete"
                                       title="Delete">

                                        <i class="bi bi-trash3"></i>

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="8" class="empty-state">

                            <i class="bi bi-diagram-3"></i>

                            <div>
                                No plans found.
                            </div>

                            <a asp-action="Create">
                                Add your first plan
                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>