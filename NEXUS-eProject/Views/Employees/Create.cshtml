@model NEXUS_eProject.Models.EmployeeCreateViewModel

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    ViewData["Title"] = "Add Employee";
    ViewData["PageTitle"] = "Add Employee";
    ViewData["PageSubtitle"] = "Create a new Nexus employee";
}

<div class="page-heading">

    <div>
        <h2>Add Employee</h2>
        <p>Create a new employee account.</p>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i>
        Back
    </a>

</div>


<div class="form-card">

    <form asp-action="Create" method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="text-danger mb-3">
        </div>


        <div class="form-grid">

            <!-- Full Name -->
            <div class="form-group">

                <label asp-for="FullName">
                    Full Name
                </label>

                <input asp-for="FullName"
                       class="form-control nexus-input"
                       placeholder="Enter employee name" />

                <span asp-validation-for="FullName"
                      class="text-danger">
                </span>

            </div>


            <!-- Email -->
            <div class="form-group">

                <label asp-for="Email">
                    Email Address
                </label>

                <input asp-for="Email"
                       class="form-control nexus-input"
                       placeholder="employee@nexus.com"
                       autocomplete="email" />

                <span asp-validation-for="Email"
                      class="text-danger">
                </span>

            </div>


            <!-- Phone -->
            <div class="form-group">

                <label asp-for="Phone">
                    Phone Number
                </label>

                <input asp-for="Phone"
                       class="form-control nexus-input"
                       placeholder="03XX-XXXXXXX" />

                <span asp-validation-for="Phone"
                      class="text-danger">
                </span>

            </div>


            <!-- Department -->
            <div class="form-group">

                <label asp-for="Department">
                    Department
                </label>

                <input asp-for="Department"
                       class="form-control nexus-input"
                       placeholder="e.g. Retail" />

                <span asp-validation-for="Department"
                      class="text-danger">
                </span>

            </div>


            <!-- Role -->
            <div class="form-group">

                <label asp-for="Role">
                    Employee Role
                </label>

                <select asp-for="Role"
                        class="form-control nexus-input">

                    <option value="">
                        Select Role
                    </option>

                    <option value="Retail Employee">
                        Retail Employee
                    </option>

                    <option value="Technical Employee">
                        Technical Employee
                    </option>

                    <option value="Accounts Employee">
                        Accounts Employee
                    </option>

                </select>

                <span asp-validation-for="Role"
                      class="text-danger">
                </span>

            </div>


            <!-- Password -->
            <div class="form-group">

                <label asp-for="Password">
                    Password
                </label>

                <input asp-for="Password"
                       class="form-control nexus-input"
                       placeholder="Enter password"
                       autocomplete="new-password" />

                <span asp-validation-for="Password"
                      class="text-danger">
                </span>

            </div>


            <!-- Confirm Password -->
            <div class="form-group">

                <label asp-for="ConfirmPassword">
                    Confirm Password
                </label>

                <input asp-for="ConfirmPassword"
                       class="form-control nexus-input"
                       placeholder="Confirm password"
                       autocomplete="new-password" />

                <span asp-validation-for="ConfirmPassword"
                      class="text-danger">
                </span>

            </div>


            <!-- Address -->
            <div class="form-group full-width">

                <label asp-for="Address">
                    Address
                </label>

                <textarea asp-for="Address"
                          class="form-control nexus-input"
                          rows="3"
                          placeholder="Enter complete employee address">
                </textarea>

                <span asp-validation-for="Address"
                      class="text-danger">
                </span>

            </div>

        </div>


        <div class="form-footer">

            <a asp-action="Index"
               class="btn btn-outline-secondary">
                Cancel
            </a>

            <button type="submit"
                    class="btn nexus-btn">

                <i class="bi bi-person-plus"></i>
                Save Employee

            </button>

        </div>

    </form>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}