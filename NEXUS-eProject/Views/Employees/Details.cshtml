@model NEXUS_eProject.Models.Employee

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    ViewData["Title"] = "Employee Details";
    ViewData["PageTitle"] = "Employee Details";
    ViewData["PageSubtitle"] = "View complete employee information";
}

<div class="page-heading">
    <div>
        <h2>Employee Details</h2>
        <p>Complete information about this employee.</p>
    </div>

    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left"></i>
        Back
    </a>
</div>

<div class="form-card">

    <div class="details-header">
        <div class="details-avatar">
            <i class="bi bi-person"></i>
        </div>

        <div>
            <h3>@Model.FullName</h3>
            <span class="details-role">@Model.Role</span>
        </div>
    </div>

    <div class="details-section">
        <h4>
            <i class="bi bi-person-vcard"></i>
            Personal Information
        </h4>

        <div class="details-grid">

            <div class="detail-item">
                <span class="detail-label">Full Name</span>
                <span class="detail-value">@Model.FullName</span>
            </div>

            <div class="detail-item">
                <span class="detail-label">Email Address</span>
                <span class="detail-value">@Model.Email</span>
            </div>

            <div class="detail-item">
                <span class="detail-label">Phone Number</span>
                <span class="detail-value">
                    @(string.IsNullOrWhiteSpace(Model.Phone)
                        ? "Not provided"
                        : Model.Phone)
                </span>
            </div>

            <div class="detail-item">
                <span class="detail-label">Department</span>
                <span class="detail-value">
                    @(string.IsNullOrWhiteSpace(Model.Department)
                        ? "Not provided"
                        : Model.Department)
                </span>
            </div>

            <div class="detail-item">
                <span class="detail-label">Role</span>
                <span class="detail-value">@Model.Role</span>
            </div>

            <div class="detail-item">
                <span class="detail-label">Account Status</span>
                <span class="detail-value">
                    @if (Model.IsActive)
                    {
                        <span class="status-badge active">Active</span>
                    }
                    else
                    {
                        <span class="status-badge inactive">Inactive</span>
                    }
                </span>
            </div>

            <div class="detail-item full-width">
                <span class="detail-label">Address</span>
                <span class="detail-value">
                    @(string.IsNullOrWhiteSpace(Model.Address)
                        ? "Not provided"
                        : Model.Address)
                </span>
            </div>

            <div class="detail-item">
                <span class="detail-label">Created Date</span>
                <span class="detail-value">
                    @Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")
                </span>
            </div>

            <div class="detail-item">
                <span class="detail-label">Employee ID</span>
                <span class="detail-value">
                    #@Model.EmployeeId
                </span>
            </div>

        </div>
    </div>

    <div class="details-section">
        <h4>
            <i class="bi bi-shield-lock"></i>
            Login Information
        </h4>

        <div class="details-grid">

            <div class="detail-item">
                <span class="detail-label">Login Email</span>
                <span class="detail-value">@Model.Email</span>
            </div>

            <div class="detail-item">
                <span class="detail-label">Password</span>
                <span class="detail-value password-hidden">
                    <i class="bi bi-lock-fill"></i>
                    Hidden for security
                </span>
            </div>

        </div>

        <div class="security-note">
            <i class="bi bi-info-circle"></i>
            Employee passwords are securely hashed and cannot be displayed.
        </div>
    </div>

    <div class="form-footer">

        <a asp-action="Index"
           class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left"></i>
            Back
        </a>

        <a asp-action="Edit"
           asp-route-id="@Model.EmployeeId"
           class="btn nexus-btn">
            <i class="bi bi-pencil"></i>
            Edit Employee
        </a>

    </div>

</div>