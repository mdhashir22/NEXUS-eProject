@model IEnumerable<NEXUS_eProject.Models.Employee>

@{
    ViewData["Title"] = "Employees";
    ViewData["PageTitle"] = "Employees";
    ViewData["PageSubtitle"] = "Manage Nexus employees";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-heading">

    <div>
        <h2>Employees</h2>
        <p>Manage all employees and their roles.</p>
    </div>

    <a asp-action="Create"
       class="dashboard-action">
        <i class="bi bi-person-plus"></i>
        Add Employee
    </a>

</div>


@if (TempData["SuccessMessage"] != null)
{
    <div class="success-alert">
        <i class="bi bi-check-circle-fill"></i>

        <span>@TempData["SuccessMessage"]</span>
    </div>
}


<div class="dashboard-card">

    <div class="card-header">

        <div>
            <h5>Employee List</h5>
            <span>
                @Model.Count() employees registered
            </span>
        </div>

    </div>


    <div class="table-responsive">

        <table class="nexus-table">

            <thead>
                <tr>
                    <th>ID</th>
                    <th>Employee</th>
                    <th>Contact</th>
                    <th>Role</th>
                    <th>Department</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>

            <tbody>

                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7"
                            class="empty-state">

                            <i class="bi bi-people"></i>

                            <div>
                                No employees found.
                            </div>

                            <a asp-action="Create">
                                Add your first employee
                            </a>

                        </td>
                    </tr>
                }
                else
                {
                    foreach (var employee in Model)
                    {
                        <tr>

                            <td>
                                #@employee.EmployeeId
                            </td>

                            <td>

                                <div class="employee-cell">

                                    <div class="employee-avatar">
                                        @employee.FullName
                                    </div>

                                    <div>
                                        <strong>
                                            @employee.FullName
                                        </strong>

                                        <small>
                                            @employee.Email
                                        </small>
                                    </div>

                                </div>

                            </td>

                            <td>
                                @(employee.Phone ?? "N/A")
                            </td>

                            <td>
                                <span class="role-badge">
                                    @employee.Role
                                </span>
                            </td>

                            <td>
                                @(employee.Department ?? "N/A")
                            </td>

                            <td>

                                @if (employee.IsActive)
                                {
                                    <span class="status-badge active">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge inactive">
                                        Inactive
                                    </span>
                                }

                            </td>

                            <td>

                                <div class="table-actions">

                                    <a asp-action="Details"
                                        asp-route-id="@employee.EmployeeId"
                                        class="table-action details"
                                        title="View Details">
                                         <i class="bi bi-eye"></i>
                                    </a>

                                    <a asp-actioSn="Edit"
                                       asp-route-id="@employee.EmployeeId"
                                       class="table-action edit"
                                       title="Edit">
                                        <i class="bi bi-pencil"></i>
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@employee.EmployeeId"
                                       class="table-action delete"
                                       title="Delete">
                                        <i class="bi bi-trash"></i>
                                    </a>

                                </div>

                            </td>

                        </tr>
                    }
                }

            </tbody>

        </table>

    </div>

</div>