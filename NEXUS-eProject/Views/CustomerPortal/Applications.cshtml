@model IEnumerable<NEXUS_eProject.Models.Order>

@{
    Layout = "_PublicLayout";
    ViewData["Title"] = "My Applications";
}

<div class="customer-applications-page">

    <div class="container">

        <!-- PAGE HEADER -->
        <div class="customer-page-header">

            <div>
                <span class="portal-eyebrow">
                    <i class="bi bi-file-earmark-text"></i>
                    CUSTOMER PORTAL
                </span>

                <h1>My Applications</h1>

                <p>
                    View and track all your connection applications
                    submitted to NEXUS.
                </p>
            </div>

            <a asp-controller="CustomerPortal"
               asp-action="Apply"
               class="btn-nexus-primary">

                <i class="bi bi-plus-lg"></i>
                New Application

            </a>

        </div>


        <!-- BACK -->
        <div class="application-back-wrapper">

            <a asp-controller="CustomerPortal"
               asp-action="Index"
               class="portal-back-link">

                <i class="bi bi-arrow-left"></i>
                Back to My Account

            </a>

        </div>


        @if (Model != null && Model.Any())
        {
            <!-- APPLICATION COUNT -->
            <div class="applications-summary">

                <div class="applications-summary-icon">
                    <i class="bi bi-files"></i>
                </div>

                <div>
                    <span>Total Applications</span>
                    <strong>@Model.Count()</strong>
                </div>

            </div>


            <!-- APPLICATIONS -->
            <div class="applications-list">

                @foreach (var application in Model)
                {
                    var statusClass =
                        application.Status?.ToLowerInvariant()
                        .Replace(" ", "-") ?? "pending";

                    <div class="application-list-card">

                        <!-- TOP -->
                        <div class="application-card-top">

                            <div class="application-card-number">

                                <span>APPLICATION ID</span>

                                <strong>
                                    @application.OrderNumber
                                </strong>

                            </div>


                            <div class="application-status-badge @statusClass">

                                <span class="status-dot"></span>

                                @application.Status

                            </div>

                        </div>


                        <!-- DETAILS -->
                        <div class="application-card-details">

                            <div class="application-info-item">

                                <span>
                                    <i class="bi bi-hdd-network"></i>
                                    Connection
                                </span>

                                <strong>
                                    @application.ConnectionType
                                </strong>

                            </div>


                            <div class="application-info-item">

                                <span>
                                    <i class="bi bi-speedometer2"></i>
                                    Plan
                                </span>

                                <strong>
                                    @(application.Plan?.PlanName ?? "N/A")
                                </strong>

                            </div>


                            <div class="application-info-item">

                                <span>
                                    <i class="bi bi-calendar3"></i>
                                    Applied On
                                </span>

                                <strong>
                                    @application.CreatedAt.ToString("dd MMM yyyy")
                                </strong>

                            </div>


                            <div class="application-info-item">

                                <span>
                                    <i class="bi bi-clock"></i>
                                    Time
                                </span>

                                <strong>
                                    @application.CreatedAt.ToString("hh:mm tt")
                                </strong>

                            </div>

                        </div>


                        <!-- BOTTOM -->
                        <div class="application-card-bottom">

                            <span class="application-card-note">

                                <i class="bi bi-info-circle"></i>

                                Track your application status
                                from the details page.

                            </span>


                            <a asp-controller="CustomerPortal"
                               asp-action="ApplicationDetails"
                               asp-route-id="@application.OrderId"
                               class="application-view-btn">

                                View Details

                                <i class="bi bi-arrow-right"></i>

                            </a>

                        </div>

                    </div>
                }

            </div>
        }
        else
        {
            <!-- EMPTY STATE -->
            <div class="applications-empty">

                <div class="applications-empty-icon">
                    <i class="bi bi-file-earmark-plus"></i>
                </div>

                <h2>No Applications Yet</h2>

                <p>
                    You haven't submitted any connection application yet.
                    Start your first application and choose the service
                    you need.
                </p>

                <a asp-controller="CustomerPortal"
                   asp-action="Apply"
                   class="btn-nexus-primary">

                    <i class="bi bi-plus-lg"></i>
                    Apply for New Connection

                </a>

            </div>
        }

    </div>

</div>