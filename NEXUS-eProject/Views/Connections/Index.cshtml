@model IEnumerable<NEXUS_eProject.Models.Connection>

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    ViewData["Title"] = "Connections";
    ViewData["PageTitle"] = "Connections";
    ViewData["PageSubtitle"] = "Monitor all active and pending customer connections";
}

<div class="page-heading">

    <div>
        <h2>Connections</h2>
        <p>View and monitor customer internet and telephone connections.</p>
    </div>

</div>

<div class="dashboard-card">

    <div class="card-header">

        <div>
            <h5>Connection List</h5>
            <span>All customer connections registered in Nexus</span>
        </div>

        <span class="table-count">
            @Model.Count() Connections
        </span>

    </div>

    <div class="table-responsive">

        <table class="table nexus-table">

            <thead>

                <tr>

                    <th>Account ID</th>
                    <th>Customer</th>
                    <th>Connection</th>
                    <th>Plan</th>
                    <th>Equipment</th>
                    <th>Installation</th>
                    <th>Status</th>
                    <th class="text-end">Actions</th>

                </tr>

            </thead>

            <tbody>

                @if (Model.Any())
                {
                    foreach (var connection in Model)
                    {
                        var installationDate = connection.InstallationDate.HasValue
                            ? connection.InstallationDate.Value.ToString("dd MMM yyyy")
                            : null;

                        <tr>

                            <!-- Account ID -->

                            <td>

                                <span class="customer-id">
                                    @connection.AccountId
                                </span>

                            </td>


                            <!-- Customer -->

                            <td>

                                <div class="customer-info">

                                    <div class="customer-avatar">
                                        <i class="bi bi-person"></i>
                                    </div>

                                    <div>

                                        <strong>
                                            @connection.Customer.FullName
                                        </strong>

                                        <small>
                                            @connection.Customer.Phone
                                        </small>

                                    </div>

                                </div>

                            </td>


                            <!-- Connection Type -->

                            <td>

                                <span>
                                    @connection.ConnectionType
                                </span>

                            </td>


                            <!-- Plan -->

                            <td>

                                <div>

                                    <strong>
                                        @connection.Plan.PlanName
                                    </strong>

                                    @if (!string.IsNullOrWhiteSpace(connection.Plan.Speed))
                                    {
                                        <small class="d-block text-muted">
                                            @connection.Plan.Speed
                                        </small>
                                    }

                                </div>

                            </td>


                            <!-- Equipment -->

                            <td>

                                @if (string.IsNullOrWhiteSpace(connection.Equipment))
                                {
                                    <span class="text-muted">
                                        Not Assigned
                                    </span>
                                }
                                else
                                {
                                    <span>
                                        @connection.Equipment
                                    </span>
                                }

                            </td>


                            <!-- Installation Date -->

                            <td>

                                @if (!string.IsNullOrWhiteSpace(installationDate))
                                {
                                    <span>
                                        @installationDate
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">
                                        Not Installed
                                    </span>
                                }

                            </td>


                            <!-- Status -->

                            <td>

                                @if (connection.Status == "Active")
                                {
                                    <span class="status-badge active">
                                        Active
                                    </span>
                                }
                                else if (connection.Status == "Suspended")
                                {
                                    <span class="status-badge inactive">
                                        Suspended
                                    </span>
                                }
                                else if (connection.Status == "Terminated")
                                {
                                    <span class="status-badge inactive">
                                        Terminated
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge pending">
                                        @connection.Status
                                    </span>
                                }

                            </td>


                            <!-- Actions -->

                            <td class="text-end">

                                <div class="action-buttons">

                                    <a asp-action="Details"
                                       asp-route-id="@connection.ConnectionId"
                                       class="btn btn-sm btn-outline-info"
                                       title="View Connection Details">

                                        <i class="bi bi-eye"></i>

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="8">

                            <div class="empty-state">

                                <div class="empty-state-icon">
                                    <i class="bi bi-router"></i>
                                </div>

                                <h5>No Connections Found</h5>

                                <p>
                                    No customer connections have been created yet.
                                </p>

                            </div>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>