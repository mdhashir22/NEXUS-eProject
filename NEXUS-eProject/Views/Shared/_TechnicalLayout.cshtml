@using Microsoft.AspNetCore.Identity
@inject UserManager<IdentityUser> UserManager

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - NEXUS Technical</title>


    <!-- ================================================= -->
    <!-- BOOTSTRAP -->
    <!-- ================================================= -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />


    <!-- ================================================= -->
    <!-- BOOTSTRAP ICONS -->
    <!-- ================================================= -->

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />


    <!-- ================================================= -->
    <!-- NEXUS TECHNICAL CSS -->
    <!-- ================================================= -->

    <link rel="stylesheet"
          href="~/css/technical.css"
          asp-append-version="true" />

</head>


<body>

    @{

        var currentController =
            ViewContext.RouteData.Values["controller"]?.ToString();

        var currentAction =
            ViewContext.RouteData.Values["action"]?.ToString();

        var currentUser =
            await UserManager.GetUserAsync(User);

        var userEmail =
            currentUser?.Email ?? "Technical Employee";

        var userInitial =
            string.IsNullOrWhiteSpace(userEmail)
                ? "T"
                : userEmail.Substring(0, 1).ToUpper();

    }


    <!-- ================================================= -->
    <!-- TECHNICAL WRAPPER -->
    <!-- ================================================= -->

    <div class="technical-wrapper">


        <!-- ================================================= -->
        <!-- SIDEBAR -->
        <!-- ================================================= -->

        <aside class="technical-sidebar"
               id="technicalSidebar">


            <!-- ================================================= -->
            <!-- BRAND -->
            <!-- ================================================= -->

            <div class="technical-brand">

                <div class="technical-brand-icon">

                    <i class="bi bi-grid-1x2-fill"></i>

                </div>

                <div class="technical-brand-text">

                    <h4>
                        NEXUS
                    </h4>

                    <span>
                        Technical Portal
                    </span>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- SIDEBAR MENU -->
            <!-- ================================================= -->

            <nav class="technical-sidebar-menu">


                <!-- ================================================= -->
                <!-- MAIN MENU -->
                <!-- ================================================= -->

                <div class="technical-menu-title">
                    MAIN MENU
                </div>


                <!-- Dashboard -->

                <a asp-controller="Technical"
                   asp-action="Dashboard"
                   class="technical-menu-item @(currentController == "Technical" && currentAction == "Dashboard" ? "active" : "")">

                    <i class="bi bi-grid-1x2"></i>

                    <span>
                        Dashboard
                    </span>

                </a>


                <!-- ================================================= -->
                <!-- TECHNICAL OPERATIONS -->
                <!-- ================================================= -->

                <div class="technical-menu-title">
                    TECHNICAL OPERATIONS
                </div>


                <!-- Pending Orders -->

                <a asp-controller="TechnicalOrder"
                   asp-action="Pending"
                   class="technical-menu-item @(currentController == "TechnicalOrder" && currentAction == "Pending" ? "active" : "")">

                    <i class="bi bi-hourglass-split"></i>

                    <span>
                        Pending Orders
                    </span>

                </a>


                <!-- Feasibility -->

                <a asp-controller="TechnicalOrder"
                   asp-action="Feasibility"
                   class="technical-menu-item @(currentController == "TechnicalOrder" && currentAction == "Feasibility" ? "active" : "")">

                    <i class="bi bi-clipboard-check"></i>

                    <span>
                        Feasibility
                    </span>

                </a>


                <!-- Technical Orders -->

                <a asp-controller="TechnicalOrder"
                   asp-action="Index"
                   class="technical-menu-item @(currentController == "TechnicalOrder" && currentAction == "Index" ? "active" : "")">

                    <i class="bi bi-list-check"></i>

                    <span>
                        Technical Orders
                    </span>

                </a>


                <!-- ================================================= -->
                <!-- CONNECTIONS -->
                <!-- ================================================= -->

                <div class="technical-menu-title">
                    CONNECTIONS
                </div>


                <!-- Connections -->

                <a asp-controller="TechnicalConnection"
                   asp-action="Index"
                   class="technical-menu-item @(currentController == "TechnicalConnection" && currentAction == "Index" ? "active" : "")">

                    <i class="bi bi-diagram-3"></i>

                    <span>
                        Connections
                    </span>

                </a>


                <!-- Installations -->

                <a asp-controller="TechnicalInstallation"
                   asp-action="Index"
                   class="technical-menu-item @(currentController == "TechnicalInstallation" ? "active" : "")">

                    <i class="bi bi-tools"></i>

                    <span>
                        Installations
                    </span>

                </a>


                <!-- Active Connections -->

                <a asp-controller="TechnicalConnection"
                   asp-action="Active"
                   class="technical-menu-item @(currentController == "TechnicalConnection" && currentAction == "Active" ? "active" : "")">

                    <i class="bi bi-wifi"></i>

                    <span>
                        Active Connections
                    </span>

                </a>


                <!-- ================================================= -->
                <!-- EQUIPMENT -->
                <!-- ================================================= -->

                <div class="technical-menu-title">
                    EQUIPMENT
                </div>


                <!-- Equipment -->

                <a asp-controller="TechnicalEquipment"
                   asp-action="Index"
                   class="technical-menu-item @(currentController == "TechnicalEquipment" && currentAction == "Index" ? "active" : "")">

                    <i class="bi bi-box-seam"></i>

                    <span>
                        Equipment
                    </span>

                </a>


                <!-- Assignments -->

                <a asp-controller="TechnicalEquipment"
                   asp-action="Assignments"
                   class="technical-menu-item @(currentController == "TechnicalEquipment" && currentAction == "Assignments" ? "active" : "")">

                    <i class="bi bi-diagram-3"></i>

                    <span>
                        Assignments
                    </span>

                </a>


                <!-- ================================================= -->
                <!-- ACCOUNT -->
                <!-- ================================================= -->

                <div class="technical-menu-title">
                    ACCOUNT
                </div>


                <!-- Profile -->

                <a asp-controller="TechnicalProfile"
                   asp-action="Index"
                   class="technical-menu-item @(currentController == "TechnicalProfile" ? "active" : "")">

                    <i class="bi bi-person-circle"></i>

                    <span>
                        Profile
                    </span>

                </a>


                <!-- Logout -->

                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post"
                      class="technical-logout-form">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="technical-menu-item technical-logout">

                        <i class="bi bi-box-arrow-right"></i>

                        <span>
                            Logout
                        </span>

                    </button>

                </form>


            </nav>


            <!-- ================================================= -->
            <!-- SIDEBAR BOTTOM -->
            <!-- ================================================= -->

            <div class="technical-sidebar-bottom">


                <!-- Support -->

                <div class="technical-sidebar-footer">

                    <div class="technical-support-icon">

                        <i class="bi bi-headset"></i>

                    </div>

                    <div>

                        <strong>
                            Technical Support
                        </strong>

                        <span>
                            NEXUS Management
                        </span>

                    </div>

                </div>

            </div>


        </aside>


        <!-- ================================================= -->
        <!-- MOBILE OVERLAY -->
        <!-- ================================================= -->

        <div class="technical-overlay"
             id="technicalOverlay">
        </div>


        <!-- ================================================= -->
        <!-- MAIN CONTENT -->
        <!-- ================================================= -->

        <main class="technical-main">


            <!-- ================================================= -->
            <!-- TOPBAR -->
            <!-- ================================================= -->

            <header class="technical-topbar">


                <!-- TOPBAR LEFT -->

                <div class="technical-topbar-left">


                    <!-- Mobile Sidebar Toggle -->

                    <button class="technical-mobile-toggle"
                            id="technicalSidebarToggle"
                            type="button">

                        <i class="bi bi-list"></i>

                    </button>


                    <!-- Page Heading -->

                    <div class="technical-topbar-heading">

                        <span>
                            TECHNICAL PORTAL
                        </span>

                        <strong>
                            @(ViewData["PageTitle"] ?? ViewData["Title"] ?? "Dashboard")
                        </strong>

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- TOPBAR RIGHT -->
                <!-- ================================================= -->

                <div class="technical-topbar-right">


                    <!-- Search -->

                    <div class="technical-search-box">

                        <i class="bi bi-search"></i>

                        <input type="text"
                               placeholder="Search..." />

                    </div>


                    <!-- Notifications -->

                    <button class="technical-icon-button"
                            type="button"
                            title="Notifications">

                        <i class="bi bi-bell"></i>

                        <span class="technical-notification-dot"></span>

                    </button>


                    <!-- ================================================= -->
                    <!-- PROFILE -->
                    <!-- ================================================= -->

                    <div class="technical-profile">

                        <div class="technical-profile-avatar">

                            @userInitial

                        </div>


                        <div class="technical-profile-info">

                            <strong>
                                Technical Employee
                            </strong>

                            <span>
                                @userEmail
                            </span>

                        </div>


                        <i class="bi bi-chevron-down technical-profile-arrow"></i>

                    </div>


                </div>


            </header>


            <!-- ================================================= -->
            <!-- PAGE CONTENT -->
            <!-- ================================================= -->

            <section class="technical-content">

                @RenderBody()

            </section>


        </main>


    </div>


    <!-- ================================================= -->
    <!-- BOOTSTRAP JS -->
    <!-- ================================================= -->

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>


    <!-- ================================================= -->
    <!-- TECHNICAL SIDEBAR JS -->
    <!-- ================================================= -->

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const sidebar =
                document.getElementById("technicalSidebar");

            const toggle =
                document.getElementById("technicalSidebarToggle");

            const overlay =
                document.getElementById("technicalOverlay");


            /* =========================================
               OPEN / CLOSE SIDEBAR
               ========================================= */

            if (toggle && sidebar) {

                toggle.addEventListener("click", function () {

                    sidebar.classList.toggle("show");

                    if (overlay) {

                        overlay.classList.toggle("show");

                    }

                });

            }


            /* =========================================
               CLOSE USING OVERLAY
               ========================================= */

            if (overlay && sidebar) {

                overlay.addEventListener("click", function () {

                    sidebar.classList.remove("show");

                    overlay.classList.remove("show");

                });

            }


            /* =========================================
               CLOSE AFTER MENU CLICK
               ========================================= */

            document
                .querySelectorAll(".technical-menu-item")
                .forEach(function (item) {

                    item.addEventListener("click", function () {

                        if (window.innerWidth <= 991) {

                            sidebar?.classList.remove("show");

                            overlay?.classList.remove("show");

                        }

                    });

                });


            /* =========================================
               RESET MOBILE SIDEBAR ON RESIZE
               ========================================= */

            window.addEventListener("resize", function () {

                if (window.innerWidth > 991) {

                    sidebar?.classList.remove("show");

                    overlay?.classList.remove("show");

                }

            });

        });

    </script>


    <!-- ================================================= -->
    <!-- PAGE SCRIPTS -->
    <!-- ================================================= -->

    @await RenderSectionAsync(
        "Scripts",
        required: false)

</body>

</html>