@using Microsoft.AspNetCore.Identity
@inject UserManager<IdentityUser> UserManager

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport"
          content="width=device-width, initial-scale=1.0" />

    <title>@ViewData["Title"] - NEXUS Accounts</title>

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />

    <link rel="stylesheet"
          href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />

    <link rel="stylesheet"
          href="~/css/accounts.css"
          asp-append-version="true" />
</head>

<body>

    @{
        var controller =
            ViewContext.RouteData.Values["controller"]?.ToString();

        var action =
            ViewContext.RouteData.Values["action"]?.ToString();

        var currentUser =
            await UserManager.GetUserAsync(User);

        var email =
            currentUser?.Email ?? "Accounts Employee";

        var initial =
            string.IsNullOrWhiteSpace(email)
                ? "A"
                : email.Substring(0, 1).ToUpper();
    }

    <div class="accounts-wrapper">

        <aside class="accounts-sidebar"
               id="accountsSidebar">

            <div class="accounts-brand">

                <div class="accounts-brand-icon">
                    <i class="bi bi-grid-1x2-fill"></i>
                </div>

                <div class="accounts-brand-text">
                    <h4>NEXUS</h4>
                    <span>Accounts Portal</span>
                </div>

            </div>


            <nav class="accounts-menu">

                <div class="accounts-menu-title">
                    MAIN MENU
                </div>

                <a asp-controller="Accounts"
                   asp-action="Dashboard"
                   class="accounts-menu-item @(controller == "Accounts" ? "active" : "")">

                    <i class="bi bi-grid"></i>
                    <span>Dashboard</span>

                </a>


                <div class="accounts-menu-title">
                    BILLING
                </div>

                <a asp-controller="AccountsBill"
                   asp-action="Pending"
                   class="accounts-menu-item @(controller == "AccountsBill" && action == "Pending" ? "active" : "")">

                    <i class="bi bi-hourglass-split"></i>
                    <span>Billing Pending</span>

                </a>

                <a asp-controller="AccountsBill"
                   asp-action="Index"
                   class="accounts-menu-item @(controller == "AccountsBill" && action != "Pending" ? "active" : "")">

                    <i class="bi bi-receipt"></i>
                    <span>Bills</span>

                </a>


                <div class="accounts-menu-title">
                    PAYMENTS
                </div>

                <a asp-controller="AccountsPayment"
                   asp-action="Pending"
                   class="accounts-menu-item @(controller == "AccountsPayment" && action == "Pending" ? "active" : "")">

                    <i class="bi bi-clock-history"></i>
                    <span>Pending Verification</span>

                </a>

                <a asp-controller="AccountsPayment"
                   asp-action="Index"
                   class="accounts-menu-item @(controller == "AccountsPayment" && action != "Pending" ? "active" : "")">

                    <i class="bi bi-credit-card"></i>
                    <span>Payments</span>

                </a>


                <div class="accounts-menu-title">
                    RECORDS
                </div>

                <a asp-controller="AccountsCustomer"
                   asp-action="Index"
                   class="accounts-menu-item @(controller == "AccountsCustomer" ? "active" : "")">

                    <i class="bi bi-people"></i>
                    <span>Customers</span>

                </a>

                <a asp-controller="AccountsConnection"
                   asp-action="Index"
                   class="accounts-menu-item @(controller == "AccountsConnection" ? "active" : "")">

                    <i class="bi bi-router"></i>
                    <span>Connections</span>

                </a>


                <div class="accounts-menu-title">
                    ACCOUNT
                </div>

                <a asp-controller="AccountsProfile"
                   asp-action="Index"
                   class="accounts-menu-item @(controller == "AccountsProfile" ? "active" : "")">

                    <i class="bi bi-person-circle"></i>
                    <span>Profile</span>

                </a>


                <form asp-controller="Account"
                      asp-action="Logout"
                      method="post"
                      class="accounts-logout-form">

                    @Html.AntiForgeryToken()

                    <button type="submit"
                            class="accounts-menu-item accounts-logout">

                        <i class="bi bi-box-arrow-right"></i>
                        <span>Logout</span>

                    </button>

                </form>

            </nav>


            <div class="accounts-sidebar-footer">

                <div class="accounts-footer-icon">
                    <i class="bi bi-shield-check"></i>
                </div>

                <div>
                    <strong>Accounts Department</strong>
                    <span>NEXUS Management</span>
                </div>

            </div>

        </aside>


        <div class="accounts-overlay"
             id="accountsOverlay">
        </div>


        <main class="accounts-main">

            <header class="accounts-topbar">

                <div class="accounts-topbar-left">

                    <button type="button"
                            class="accounts-mobile-toggle"
                            id="accountsSidebarToggle">

                        <i class="bi bi-list"></i>

                    </button>

                    <div class="accounts-heading">
                        <span>ACCOUNTS PORTAL</span>

                        <strong>
                            @(ViewData["PageTitle"]
                                ?? ViewData["Title"]
                                ?? "Dashboard")
                        </strong>
                    </div>

                </div>


                <div class="accounts-topbar-right">

                    <div class="accounts-search">
                        <i class="bi bi-search"></i>

                        <input type="text"
                               placeholder="Search..." />
                    </div>

                    <button type="button"
                            class="accounts-icon-btn">

                        <i class="bi bi-bell"></i>

                        <span class="accounts-notification-dot"></span>

                    </button>


                    <div class="accounts-profile">

                        <div class="accounts-avatar">
                            @initial
                        </div>

                        <div class="accounts-profile-info">

                            <strong>
                                Accounts Employee
                            </strong>

                            <span>
                                @email
                            </span>

                        </div>

                        <i class="bi bi-chevron-down"></i>

                    </div>

                </div>

            </header>


            <section class="accounts-content">

                @RenderBody()

            </section>

        </main>

    </div>


    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    <script>
            document.addEventListener("DOMContentLoaded", function () {

                const sidebar =
                    document.getElementById("accountsSidebar");

                const toggle =
                    document.getElementById("accountsSidebarToggle");

                const overlay =
                    document.getElementById("accountsOverlay");

                if (toggle && sidebar) {
                    toggle.addEventListener("click", function () {

                        sidebar.classList.toggle("show");

                        if (overlay) {
                            overlay.classList.toggle("show");
                        }

                    });
                }

                if (overlay && sidebar) {
                    overlay.addEventListener("click", function () {

                        sidebar.classList.remove("show");
                        overlay.classList.remove("show");

                    });
                }

                document
                    .querySelectorAll(".accounts-menu-item")
                    .forEach(function (item) {

                        item.addEventListener("click", function () {

                            if (window.innerWidth <= 991) {
                                sidebar?.classList.remove("show");
                                overlay?.classList.remove("show");
                            }

                        });

                    });

                window.addEventListener("resize", function () {

                    if (window.innerWidth > 991) {
                        sidebar?.classList.remove("show");
                        overlay?.classList.remove("show");
                    }

                });

            });
    </script>

    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>