@model IEnumerable<NEXUS_eProject.Models.Order>

@{
    ViewData["Title"] = "Applications";
    ViewData["PageTitle"] = "Applications";
    Layout = "~/Views/Shared/_RetailLayout.cshtml";
}

<div class="retail-page ro-page">

    <!-- PAGE HEADER -->

    <div class="retail-page-header ro-page-header">

        <div>

            <div class="retail-page-eyebrow">
                <i class="bi bi-file-earmark-text"></i>
                RETAIL MANAGEMENT
            </div>

            <h1>Customer Applications</h1>

            <p>
                Review and manage customer connection applications.
            </p>

        </div>

        <a asp-controller="RetailCustomer"
           asp-action="Index"
           class="retail-secondary-btn ro-customers-btn">

            <i class="bi bi-people"></i>
            Customers

        </a>

    </div>


    <!-- ALERTS -->

    @if (TempData["Success"] != null)
    {
        <div class="ro-alert ro-alert-success">

            <i class="bi bi-check-circle-fill"></i>

            <span>
                @TempData["Success"]
            </span>

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="ro-alert ro-alert-danger">

            <i class="bi bi-exclamation-circle-fill"></i>

            <span>
                @TempData["Error"]
            </span>

        </div>
    }


    <!-- FILTERS -->

    <div class="retail-card ro-filter-card">

        <div class="retail-card-header">

            <div class="retail-card-title">

                <div class="retail-card-icon">
                    <i class="bi bi-funnel"></i>
                </div>

                <div>

                    <h3>
                        Application Filters
                    </h3>

                    <span>
                        Search and filter customer applications
                    </span>

                </div>

            </div>

        </div>


        <div class="retail-card-body">

            <form asp-action="Index"
                  method="get"
                  class="ro-filter-form">

                <div class="ro-filter-search">

                    <label class="ro-form-label">
                        Search
                    </label>

                    <div class="ro-input-wrapper">

                        <i class="bi bi-search"></i>

                        <input type="text"
                               name="search"
                               value="@ViewBag.Search"
                               class="form-control"
                               placeholder="Order number, customer name or phone..." />

                    </div>

                </div>


                <div>

                    <label class="ro-form-label">
                        Status
                    </label>

                    <select name="status"
                            class="form-select">

                        <option value=""
                                selected="@(string.IsNullOrEmpty(ViewBag.Status) ? "selected" : null)">
                            All Statuses
                        </option>

                        <option value="Pending"
                                selected="@(ViewBag.Status == "Pending" ? "selected" : null)">
                            Pending
                        </option>

                        <option value="Submitted"
                                selected="@(ViewBag.Status == "Submitted" ? "selected" : null)">
                            Submitted
                        </option>

                        <option value="Retail Accepted"
                                selected="@(ViewBag.Status == "Retail Accepted" ? "selected" : null)">
                            Retail Accepted
                        </option>

                        <option value="Retail Rejected"
                                selected="@(ViewBag.Status == "Retail Rejected" ? "selected" : null)">
                            Retail Rejected
                        </option>

                        <option value="Feasibility Pending"
                                selected="@(ViewBag.Status == "Feasibility Pending" ? "selected" : null)">
                            Feasibility Pending
                        </option>

                        <option value="Feasible"
                                selected="@(ViewBag.Status == "Feasible" ? "selected" : null)">
                            Feasible
                        </option>

                        <option value="Not Feasible"
                                selected="@(ViewBag.Status == "Not Feasible" ? "selected" : null)">
                            Not Feasible
                        </option>

                        <option value="Billing Pending"
                                selected="@(ViewBag.Status == "Billing Pending" ? "selected" : null)">
                            Billing Pending
                        </option>

                        <option value="Payment Pending"
                                selected="@(ViewBag.Status == "Payment Pending" ? "selected" : null)">
                            Payment Pending
                        </option>

                        <option value="Payment Verified"
                                selected="@(ViewBag.Status == "Payment Verified" ? "selected" : null)">
                            Payment Verified
                        </option>

                        <option value="Installation Pending"
                                selected="@(ViewBag.Status == "Installation Pending" ? "selected" : null)">
                            Installation Pending
                        </option>

                        <option value="Active"
                                selected="@(ViewBag.Status == "Active" ? "selected" : null)">
                            Active
                        </option>

                    </select>

                </div>


                <div>

                    <label class="ro-form-label">
                        Connection
                    </label>

                    <select name="connectionType"
                            class="form-select">

                        <option value=""
                                selected="@(string.IsNullOrWhiteSpace(ViewBag.ConnectionType) ? "selected" : null)">
                            All Types
                        </option>

                        <option value="Broadband"
                                selected="@(ViewBag.ConnectionType == "Broadband" ? "selected" : null)">
                            Broadband
                        </option>

                        <option value="Telephone"
                                selected="@(ViewBag.ConnectionType == "Telephone" ? "selected" : null)">
                            Telephone
                        </option>

                        <option value="Dial-Up"
                                selected="@(ViewBag.ConnectionType == "Dial-Up" ? "selected" : null)">
                            Dial-Up
                        </option>

                    </select>

                </div>


                <div>

                    <label class="ro-form-label ro-label-hidden">
                        Action
                    </label>

                    <button type="submit"
                            class="retail-primary-btn ro-search-btn">

                        <i class="bi bi-search"></i>
                        Search

                    </button>

                </div>

            </form>

        </div>

    </div>


    <!-- APPLICATIONS -->

    <div class="retail-card ro-applications-card">

        <div class="retail-card-header">

            <div class="retail-card-title">

                <div class="retail-card-icon">
                    <i class="bi bi-file-earmark-check"></i>
                </div>

                <div>

                    <h3>
                        Applications
                    </h3>

                    <span>
                        @Model.Count() application(s) found
                    </span>

                </div>

            </div>

        </div>


        <div class="retail-card-body p-0">

            @if (Model.Any())
            {
                <div class="ro-table-wrapper">

                    <table class="table ro-applications-table align-middle mb-0">

                        <thead>

                            <tr>

                                <th>Order</th>
                                <th>Customer</th>
                                <th>Connection</th>
                                <th>Plan</th>
                                <th>Status</th>
                                <th>Date</th>

                                <th class="text-end">
                                    Action
                                </th>

                            </tr>

                        </thead>


                        <tbody>

                            @foreach (var order in Model)
                            {
                                var isRetailPending =
                                    string.IsNullOrWhiteSpace(order.Status) ||
                                    order.Status == "Pending" ||
                                    order.Status == "Submitted";

                                <tr>

                                    <!-- ORDER -->

                                    <td>

                                        <div class="ro-order-cell">

                                            <strong>
                                                #@order.OrderNumber
                                            </strong>

                                            <span>
                                                ID: @order.OrderId
                                            </span>

                                        </div>

                                    </td>


                                    <!-- CUSTOMER -->

                                    <td>

                                        <div class="ro-customer-cell">

                                            <div class="ro-avatar">

                                                @(string.IsNullOrWhiteSpace(order.Customer?.FullName)
                                                    ? "?"
                                                    : order.Customer.FullName.Substring(0, 1).ToUpper())

                                            </div>

                                            <div class="ro-customer-info">

                                                <strong>
                                                    @(order.Customer?.FullName ?? "Unknown Customer")
                                                </strong>

                                                <span>
                                                    @(order.Customer?.Phone ?? "No phone")
                                                </span>

                                            </div>

                                        </div>

                                    </td>


                                    <!-- CONNECTION -->

                                    <td>

                                        <span class="ro-connection-badge">

                                            @if (order.ConnectionType == "Broadband")
                                            {
                                                <i class="bi bi-wifi"></i>
                                            }
                                            else if (order.ConnectionType == "Telephone")
                                            {
                                                <i class="bi bi-telephone"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-globe"></i>
                                            }

                                            @order.ConnectionType

                                        </span>

                                    </td>


                                    <!-- PLAN -->

                                    <td>

                                        <div class="ro-plan-cell">

                                            <strong>
                                                @(order.Plan?.PlanName ?? "N/A")
                                            </strong>

                                            @if (order.Plan != null)
                                            {
                                                <span>
                                                    @order.Plan.Speed
                                                </span>
                                            }

                                        </div>

                                    </td>


                                    <!-- STATUS -->

                                    <td>

                                        @{
                                            var statusClass = order.Status switch
                                            {
                                                "Pending" => "ro-status-pending",
                                                "Submitted" => "ro-status-pending",
                                                "Retail Accepted" => "ro-status-approved",
                                                "Retail Rejected" => "ro-status-rejected",
                                                "Feasibility Pending" => "ro-status-pending",
                                                "Feasible" => "ro-status-approved",
                                                "Not Feasible" => "ro-status-rejected",
                                                "Billing Pending" => "ro-status-pending",
                                                "Payment Pending" => "ro-status-pending",
                                                "Payment Verified" => "ro-status-approved",
                                                "Installation Pending" => "ro-status-pending",
                                                "Active" => "ro-status-active",
                                                _ => "ro-status-neutral"
                                            };
                                        }

                                        <span class="ro-status @statusClass">

                                            @if (isRetailPending)
                                            {
                                                <i class="bi bi-clock"></i>
                                            }
                                            else if (
                                                order.Status == "Retail Accepted" ||
                                                order.Status == "Feasible" ||
                                                order.Status == "Payment Verified" ||
                                                order.Status == "Active")
                                            {
                                                <i class="bi bi-check-circle"></i>
                                            }
                                            else if (
                                                order.Status == "Retail Rejected" ||
                                                order.Status == "Not Feasible")
                                            {
                                                <i class="bi bi-x-circle"></i>
                                            }
                                            else
                                            {
                                                <i class="bi bi-arrow-repeat"></i>
                                            }

                                            @(string.IsNullOrWhiteSpace(order.Status)
                                                ? "Pending"
                                                : order.Status)

                                        </span>

                                    </td>


                                    <!-- DATE -->

                                    <td>

                                        <div class="ro-date-cell">

                                            <strong>
                                                @order.CreatedAt.ToString("dd MMM yyyy")
                                            </strong>

                                            <span>
                                                @order.CreatedAt.ToString("hh:mm tt")
                                            </span>

                                        </div>

                                    </td>


                                    <!-- ACTION -->

                                    <td class="text-end">

                                        <div class="ro-action-buttons">

                                            <!-- DETAILS -->

                                            <a asp-action="Details"
                                               asp-route-id="@order.OrderId"
                                               class="ro-icon-btn"
                                               title="View Details">

                                                <i class="bi bi-eye"></i>

                                            </a>


                                            @if (isRetailPending)
                                            {
                                                <!-- ACCEPT -->

                                                <button type="button"
                                                        class="ro-action-btn ro-accept-btn"
                                                        title="Accept Application"
                                                        onclick="openIndexAcceptModal(
                                                            @order.OrderId,
                                                            '@Html.Raw((order.OrderNumber ?? "").Replace("'", "\\'"))',
                                                            '@Html.Raw((order.Customer?.FullName ?? "Unknown Customer").Replace("'", "\\'"))'
                                                        )">

                                                    <i class="bi bi-check-lg"></i>
                                                    Accept

                                                </button>


                                                <!-- REJECT -->

                                                <button type="button"
                                                        class="ro-action-btn ro-reject-btn"
                                                        title="Reject Application"
                                                        onclick="openIndexRejectModal(
                                                            @order.OrderId,
                                                            '@Html.Raw((order.OrderNumber ?? "").Replace("'", "\\'"))',
                                                            '@Html.Raw((order.Customer?.FullName ?? "Unknown Customer").Replace("'", "\\'"))'
                                                        )">

                                                    <i class="bi bi-x-lg"></i>
                                                    Reject

                                                </button>
                                            }
                                            else
                                            {
                                                <!-- STATUS -->

                                                <a asp-action="Status"
                                                   asp-route-id="@order.OrderId"
                                                   class="ro-icon-btn"
                                                   title="Track Status">

                                                    <i class="bi bi-activity"></i>

                                                </a>
                                            }

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="ro-empty-state">

                    <div class="ro-empty-icon">
                        <i class="bi bi-inbox"></i>
                    </div>

                    <h4>
                        No Applications Found
                    </h4>

                    <p>
                        There are no customer applications matching your filters.
                    </p>

                    <a asp-action="Index"
                       class="retail-secondary-btn">

                        <i class="bi bi-arrow-clockwise"></i>
                        Clear Filters

                    </a>

                </div>
            }

        </div>

    </div>

</div>


<!-- =========================================================
     ACCEPT APPLICATION MODAL
     ========================================================= -->

<div class="modal fade ro-confirm-modal"
     id="indexAcceptModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="ro-confirm-icon ro-confirm-icon-success">
                <i class="bi bi-check2-circle"></i>
            </div>

            <div class="ro-confirm-eyebrow">
                RETAIL REVIEW
            </div>

            <h4>Accept Application?</h4>

            <p>
                Are you sure you want to accept this application?
                It will be forwarded to the Technical Department.
            </p>

            <div class="ro-confirm-details">

                <div>
                    <span>APPLICATION</span>
                    <strong id="indexAcceptOrderNumber">—</strong>
                </div>

                <div>
                    <span>CUSTOMER</span>
                    <strong id="indexAcceptCustomerName">—</strong>
                </div>

            </div>

            <div class="ro-confirm-actions">

                <button type="button"
                        class="ro-confirm-cancel"
                        data-bs-dismiss="modal">
                    Cancel
                </button>

                <form asp-action="Accept"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           id="indexAcceptOrderId"
                           name="id" />

                    <button type="submit"
                            class="ro-confirm-accept">

                        <i class="bi bi-check2"></i>
                        Yes, Accept

                    </button>

                </form>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     REJECT APPLICATION MODAL
     ========================================================= -->

<div class="modal fade ro-confirm-modal ro-reject-modal"
     id="indexRejectModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="ro-confirm-icon ro-confirm-icon-danger">
                <i class="bi bi-x-circle"></i>
            </div>

            <div class="ro-confirm-eyebrow ro-reject-eyebrow">
                RETAIL REVIEW
            </div>

            <h4>Reject Application?</h4>

            <p>
                Please provide a reason for rejecting this application.
                The reason will be saved with the application.
            </p>

            <div class="ro-confirm-details">

                <div>
                    <span>APPLICATION</span>
                    <strong id="indexRejectOrderNumber">—</strong>
                </div>

                <div>
                    <span>CUSTOMER</span>
                    <strong id="indexRejectCustomerName">—</strong>
                </div>

            </div>

            <form asp-action="Reject"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       id="indexRejectOrderId"
                       name="id" />

                <div class="ro-reason-group">

                    <label for="indexRejectReason">
                        Rejection Reason
                    </label>

                    <textarea id="indexRejectReason"
                              name="reason"
                              rows="3"
                              maxlength="500"
                              placeholder="Enter the reason for rejection..."
                              required></textarea>

                    <span>
                        This reason will be saved in the application record.
                    </span>

                </div>

                <div class="ro-confirm-actions">

                    <button type="button"
                            class="ro-confirm-cancel"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="submit"
                            class="ro-confirm-reject">

                        <i class="bi bi-x-lg"></i>
                        Yes, Reject

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        let indexAcceptModal;
        let indexRejectModal;


        document.addEventListener("DOMContentLoaded", function () {

            const acceptElement =
                document.getElementById("indexAcceptModal");

            const rejectElement =
                document.getElementById("indexRejectModal");


            indexAcceptModal =
                new bootstrap.Modal(acceptElement);

            indexRejectModal =
                new bootstrap.Modal(rejectElement);


            rejectElement.addEventListener(
                "hidden.bs.modal",
                function () {

                    document.getElementById(
                        "indexRejectReason"
                    ).value = "";

                }
            );

        });


        function openIndexAcceptModal(
            orderId,
            orderNumber,
            customerName
        ) {

            document.getElementById(
                "indexAcceptOrderId"
            ).value = orderId;

            document.getElementById(
                "indexAcceptOrderNumber"
            ).textContent = "#" + orderNumber;

            document.getElementById(
                "indexAcceptCustomerName"
            ).textContent = customerName;

            indexAcceptModal.show();
        }


        function openIndexRejectModal(
            orderId,
            orderNumber,
            customerName
        ) {

            document.getElementById(
                "indexRejectOrderId"
            ).value = orderId;

            document.getElementById(
                "indexRejectOrderNumber"
            ).textContent = "#" + orderNumber;

            document.getElementById(
                "indexRejectCustomerName"
            ).textContent = customerName;

            document.getElementById(
                "indexRejectReason"
            ).value = "";

            indexRejectModal.show();


            setTimeout(function () {

                document.getElementById(
                    "indexRejectReason"
                ).focus();

            }, 300);
        }

    </script>
}