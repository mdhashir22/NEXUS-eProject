@model IEnumerable<NEXUS_eProject.Models.Order>

@{
    ViewData["Title"] = "Pending Applications";
    ViewData["PageTitle"] = "Pending Applications";
    Layout = "~/Views/Shared/_RetailLayout.cshtml";
}

<div class="retail-page rp-page">

    <div class="retail-page-header rp-header">

        <div>
            <div class="retail-page-eyebrow">
                <i class="bi bi-hourglass-split"></i>
                RETAIL MANAGEMENT
            </div>

            <h1>Pending Applications</h1>

            <p>
                Applications waiting for retail review.
            </p>
        </div>

        <a asp-action="Index"
           class="retail-secondary-btn rp-all-btn">
            <i class="bi bi-grid"></i>
            All Applications
        </a>

    </div>

    <div class="retail-card rp-card">

        <div class="retail-card-header">

            <div class="retail-card-title">

                <div class="retail-card-icon">
                    <i class="bi bi-hourglass-split"></i>
                </div>

                <div>
                    <h3>Pending Applications</h3>

                    <span>
                        @Model.Count() application(s) waiting for review
                    </span>
                </div>

            </div>

            <div class="rp-count">
                @Model.Count()
            </div>

        </div>

        <div class="retail-card-body p-0">

            @if (Model.Any())
            {
                <div class="rp-table-wrapper">

                    <table class="table rp-table align-middle mb-0">

                        <thead>
                            <tr>
                                <th>ORDER</th>
                                <th>CUSTOMER</th>
                                <th>CONNECTION</th>
                                <th>PLAN</th>
                                <th>DATE</th>
                                <th class="text-end">ACTION</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var order in Model)
                            {
                                var connectionIcon =
                                    order.ConnectionType == "Telephone"
                                        ? "bi-telephone"
                                        : order.ConnectionType == "Dial-Up"
                                            ? "bi-globe"
                                            : "bi-wifi";

                                <tr>

                                    <td>
                                        <div class="rp-order">

                                            <strong>
                                                #@order.OrderNumber
                                            </strong>

                                            <span>
                                                ID: @order.OrderId
                                            </span>

                                        </div>
                                    </td>

                                    <td>
                                        <div class="rp-customer">

                                            <div class="rp-avatar">
                                                @(string.IsNullOrWhiteSpace(order.Customer?.FullName)
                                                    ? "?"
                                                    : order.Customer.FullName.Substring(0, 1).ToUpper())
                                            </div>

                                            <div class="rp-customer-info">

                                                <strong>
                                                    @(order.Customer?.FullName
                                                        ?? "Unknown Customer")
                                                </strong>

                                                <span>
                                                    @(order.Customer?.Phone
                                                        ?? "No phone")
                                                </span>

                                            </div>

                                        </div>
                                    </td>

                                    <td>
                                        <span class="rp-connection">

                                            <i class="bi @connectionIcon"></i>

                                            @order.ConnectionType

                                        </span>
                                    </td>

                                    <td>
                                        <div class="rp-plan">

                                            <strong>
                                                @(order.Plan?.PlanName ?? "N/A")
                                            </strong>

                                            @if (order.Plan != null &&
                                                 !string.IsNullOrWhiteSpace(order.Plan.Speed))
                                            {
                                                <span>
                                                    @order.Plan.Speed
                                                </span>
                                            }

                                        </div>
                                    </td>

                                    <td>
                                        <div class="rp-date">

                                            <strong>
                                                @order.CreatedAt.ToString("dd MMM yyyy")
                                            </strong>

                                            <span>
                                                @order.CreatedAt.ToString("hh:mm tt")
                                            </span>

                                        </div>
                                    </td>

                                    <td class="text-end">

                                        <div class="rp-actions">

                                            <!-- VIEW -->
                                            <a asp-action="Details"
                                               asp-route-id="@order.OrderId"
                                               class="rp-icon-btn"
                                               title="View Application">

                                                <i class="bi bi-eye"></i>

                                            </a>


                                            <!-- ACCEPT -->
                                            <button type="button"
                                                    class="rp-review-btn rp-accept-btn"
                                                    onclick="openAcceptModal(
                                                @order.OrderId,
                                                '@Html.Raw((order.OrderNumber ?? "").Replace("'", "\\'"))',
                                                '@Html.Raw((order.Customer?.FullName ?? "Unknown Customer").Replace("'", "\\'"))'
                                                )">

                                                <i class="bi bi-check2-circle"></i>

                                                <span>Accept</span>

                                            </button>


                                            <!-- REJECT -->
                                            <button type="button"
                                                    class="rp-reject-btn"
                                                    onclick="openRejectModal(
                                                @order.OrderId,
                                                '@Html.Raw((order.OrderNumber ?? "").Replace("'", "\\'"))',
                                                '@Html.Raw((order.Customer?.FullName ?? "Unknown Customer").Replace("'", "\\'"))'
                                                )">

                                                <i class="bi bi-x-circle"></i>

                                                <span>Reject</span>

                                            </button>

                                        </div>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="rp-empty">

                    <div class="rp-empty-icon">
                        <i class="bi bi-check-circle"></i>
                    </div>

                    <h4>No Pending Applications</h4>

                    <p>
                        There are no applications waiting for review.
                    </p>

                    <a asp-action="Index"
                       class="retail-secondary-btn">

                        <i class="bi bi-arrow-left"></i>
                        Back to Applications

                    </a>

                </div>
            }

        </div>

    </div>

</div>


<!-- =========================================================
     ACCEPT APPLICATION MODAL
     ========================================================= -->

<div class="modal fade rp-modal"
     id="acceptApplicationModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="rp-modal-icon">
                <i class="bi bi-check2-circle"></i>
            </div>

            <div class="rp-modal-content">

                <div class="rp-modal-eyebrow">
                    RETAIL REVIEW
                </div>

                <h4>Accept Application?</h4>

                <p>
                    Are you sure you want to accept this application?
                    It will be forwarded to the Technical Department.
                </p>

                <div class="rp-modal-application">

                    <div>
                        <span>APPLICATION</span>
                        <strong id="acceptOrderNumber">—</strong>
                    </div>

                    <div>
                        <span>CUSTOMER</span>
                        <strong id="acceptCustomerName">—</strong>
                    </div>

                </div>

                <div class="rp-modal-actions">

                    <button type="button"
                            class="rp-modal-cancel"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <form id="acceptApplicationForm"
                          asp-action="Accept"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               id="acceptOrderId"
                               name="id"
                               value="" />

                        <button type="submit"
                                class="rp-modal-confirm">

                            <i class="bi bi-check2"></i>
                            Yes, Accept

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- =========================================================
     REJECT APPLICATION MODAL
     ========================================================= -->

<div class="modal fade rp-modal rp-reject-modal"
     id="rejectApplicationModal"
     tabindex="-1"
     aria-hidden="true">

    <div class="modal-dialog modal-dialog-centered">

        <div class="modal-content">

            <div class="rp-reject-modal-icon">
                <i class="bi bi-x-circle"></i>
            </div>

            <div class="rp-modal-content">

                <div class="rp-reject-eyebrow">
                    RETAIL REVIEW
                </div>

                <h4>Reject Application?</h4>

                <p>
                    Please provide a reason for rejecting this application.
                    The reason will be saved with the application.
                </p>

                <div class="rp-modal-application">

                    <div>
                        <span>APPLICATION</span>
                        <strong id="rejectOrderNumber">—</strong>
                    </div>

                    <div>
                        <span>CUSTOMER</span>
                        <strong id="rejectCustomerName">—</strong>
                    </div>

                </div>

                <form id="rejectApplicationForm"
                      asp-action="Reject"
                      method="post">

                    @Html.AntiForgeryToken()

                    <input type="hidden"
                           id="rejectOrderId"
                           name="id"
                           value="" />

                    <div class="rp-reason-group">

                        <label for="rejectReason">
                            Rejection Reason
                        </label>

                        <textarea id="rejectReason"
                                  name="reason"
                                  rows="3"
                                  maxlength="500"
                                  placeholder="Enter the reason for rejection..."
                                  required></textarea>

                        <span class="rp-reason-hint">
                            This reason will be saved in the application record.
                        </span>

                    </div>

                    <div class="rp-modal-actions">

                        <button type="button"
                                class="rp-modal-cancel"
                                data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button type="submit"
                                class="rp-modal-reject-confirm">

                            <i class="bi bi-x-lg"></i>
                            Yes, Reject

                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>


@section Scripts {

    <script>

        let acceptModal;
        let rejectModal;


        document.addEventListener("DOMContentLoaded", function () {

            const acceptModalElement =
                document.getElementById("acceptApplicationModal");

            const rejectModalElement =
                document.getElementById("rejectApplicationModal");


            acceptModal =
                new bootstrap.Modal(acceptModalElement);


            rejectModal =
                new bootstrap.Modal(rejectModalElement);


            /*
             * Clear rejection reason whenever
             * reject modal is closed.
             */

            rejectModalElement.addEventListener(
                "hidden.bs.modal",
                function () {

                    document.getElementById("rejectReason").value = "";

                }
            );

        });


        /*
         * ACCEPT MODAL
         */

        function openAcceptModal(
            orderId,
            orderNumber,
            customerName
        ) {

            document.getElementById("acceptOrderId").value =
                orderId;

            document.getElementById("acceptOrderNumber").textContent =
                "#" + orderNumber;

            document.getElementById("acceptCustomerName").textContent =
                customerName;

            acceptModal.show();
        }


        /*
         * REJECT MODAL
         */

        function openRejectModal(
            orderId,
            orderNumber,
            customerName
        ) {

            document.getElementById("rejectOrderId").value =
                orderId;

            document.getElementById("rejectOrderNumber").textContent =
                "#" + orderNumber;

            document.getElementById("rejectCustomerName").textContent =
                customerName;

            document.getElementById("rejectReason").value = "";

            rejectModal.show();


            setTimeout(function () {

                document.getElementById("rejectReason").focus();

            }, 300);
        }

    </script>
}