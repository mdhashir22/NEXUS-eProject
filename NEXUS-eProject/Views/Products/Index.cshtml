@model IEnumerable<NEXUS_eProject.Models.Product>

@{
    ViewData["Title"] = "Products";
    ViewData["PageTitle"] = "Products";
    ViewData["PageSubtitle"] = "Manage Nexus products and stock";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-heading">

    <div>
        <h2>Products</h2>
        <p>Manage products, vendors, prices and stock.</p>
    </div>

    <a asp-action="Create" class="nexus-btn">
        <i class="bi bi-plus-lg"></i>
        Add Product
    </a>

</div>


@if (TempData["SuccessMessage"] != null)
{
    <div class="success-alert">
        <i class="bi bi-check-circle-fill"></i>
        <span>@TempData["SuccessMessage"]</span>
    </div>
}


<div class="dashboard-card">

    <div class="card-header">

        <div>
            <h5>Product List</h5>

            <span>
                @Model.Count() products registered
            </span>
        </div>

    </div>


    <div class="table-responsive">

        <table class="nexus-table">

            <thead>
                <tr>
                    <th>ID</th>
                    <th>PRODUCT</th>
                    <th>VENDOR</th>
                    <th>PRICE</th>
                    <th>STOCK</th>
                    <th>STATUS</th>
                    <th>ACTIONS</th>
                </tr>
            </thead>


            <tbody>

                @if (Model.Any())
                {
                    foreach (var product in Model)
                    {
                        <tr>

                            <!-- ID -->
                            <td>
                                #@product.ProductId
                            </td>


                            <!-- PRODUCT -->
                            <td>

                                <div class="employee-cell">

                                    <div class="employee-avatar">
                                        @(string.IsNullOrWhiteSpace(product.ProductName)
                                            ? "P"
                                            : product.ProductName.Substring(0, 1).ToUpper())
                                    </div>

                                    <div>

                                        <strong>
                                            @product.ProductName
                                        </strong>

                                        <small>
                                            @product.CreatedAt.ToString("dd MMM yyyy")
                                        </small>

                                    </div>

                                </div>

                            </td>


                            <!-- VENDOR -->
                            <td>
                                @(product.Vendor?.VendorName ?? "N/A")
                            </td>


                            <!-- PRICE -->
                            <td>
                                Rs. @product.Price.ToString("N2")
                            </td>


                            <!-- STOCK -->
                            <td>
                                @product.Quantity
                            </td>


                            <!-- STATUS -->
                            <td>

                                @if (product.IsActive)
                                {
                                    <span class="status-badge active">
                                        Active
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge inactive">
                                        Inactive
                                    </span>
                                }

                            </td>


                            <!-- ACTIONS -->
                            <td>

                                <div class="table-actions">

                                    <a asp-action="Edit"
                                       asp-route-id="@product.ProductId"
                                       class="table-action edit"
                                       title="Edit">

                                        <i class="bi bi-pencil"></i>

                                    </a>


                                    <a asp-action="Delete"
                                       asp-route-id="@product.ProductId"
                                       class="table-action delete"
                                       title="Delete">

                                        <i class="bi bi-trash3"></i>

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>

                        <td colspan="7" class="empty-state">

                            <i class="bi bi-box-seam"></i>

                            <div>
                                No products found.
                            </div>

                            <a asp-action="Create">
                                Add your first product
                            </a>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>