@model NEXUS_eProject.Models.Product

@{
    ViewData["Title"] = "Add Product";
    ViewData["PageTitle"] = "Add Product";
    ViewData["PageSubtitle"] = "Create a new Nexus product";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-heading">

    <div>
        <h2>Add Product</h2>
        <p>Add a new product to the Nexus inventory.</p>
    </div>

</div>


<div class="form-card">

    <form asp-action="Create" method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="All"
     class="validation-summary">
</div>


        <div class="form-section-title">
            Product Information
        </div>


        <div class="form-grid">

            <div class="form-group">

                <label asp-for="ProductName">
                    Product Name
                </label>

                <input asp-for="ProductName"
                       class="nexus-input"
                       placeholder="Enter product name" />

                <span asp-validation-for="ProductName"
                      class="field-error">
                </span>

            </div>


            <div class="form-group">

                <label asp-for="VendorId">
                    Vendor
                </label>

                <select asp-for="VendorId"
                        asp-items="ViewBag.Vendors"
                        class="nexus-input">

                    <option value="">
                        Select Vendor
                    </option>

                </select>

                <span asp-validation-for="VendorId"
                      class="field-error">
                </span>

            </div>


            <div class="form-group">

                <label asp-for="Price">
                    Price
                </label>

                <input asp-for="Price"
                       type="number"
                       step="0.01"
                       min="0"
                       class="nexus-input"
                       placeholder="Enter product price" />

                <span asp-validation-for="Price"
                      class="field-error">
                </span>

            </div>


            <div class="form-group">

                <label asp-for="Quantity">
                    Quantity
                </label>

                <input asp-for="Quantity"
                       type="number"
                       min="0"
                       class="nexus-input"
                       placeholder="Enter stock quantity" />

                <span asp-validation-for="Quantity"
                      class="field-error">
                </span>

            </div>


            <div class="form-group full-width">

                <label asp-for="Description">
                    Description
                </label>

                <textarea asp-for="Description"
                          class="nexus-input"
                          rows="4"
                          placeholder="Enter product description">
                </textarea>

                <span asp-validation-for="Description"
                      class="field-error">
                </span>

            </div>

        </div>


        <div class="form-footer">

            <a asp-action="Index"
               class="secondary-action">

                <i class="bi bi-arrow-left"></i>
                Cancel

            </a>


            <button type="submit"
                    class="nexus-btn">

                <i class="bi bi-check-lg"></i>
                Save Product

            </button>

        </div>

    </form>

</div>


@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}