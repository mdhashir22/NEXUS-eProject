@model NEXUS_eProject.Models.AccountsDashboardViewModel

@{
    ViewData["Title"] = "Dashboard";
    ViewData["PageTitle"] = "Dashboard";
    Layout = "~/Views/Shared/_AccountsLayout.cshtml";
}

<div class="ad-page">

    <div class="ad-welcome">

        <div>
            <span class="ad-eyebrow">
                <i class="bi bi-wallet2"></i>
                ACCOUNTS OVERVIEW
            </span>

            <h2>Accounts Dashboard</h2>

            <p>
                Manage customer billing, payments and financial verification.
            </p>
        </div>

        <div class="ad-date">
            <i class="bi bi-calendar3"></i>
            @DateTime.Now.ToString("dd MMM yyyy")
        </div>

    </div>


    <div class="ad-stats">

        <div class="ad-stat">

            <div class="ad-stat-icon purple">
                <i class="bi bi-hourglass-split"></i>
            </div>

            <div>
                <span>BILLING PENDING</span>
                <strong>@Model.BillingPending</strong>
            </div>

        </div>


        <div class="ad-stat">

            <div class="ad-stat-icon blue">
                <i class="bi bi-receipt"></i>
            </div>

            <div>
                <span>TOTAL BILLS</span>
                <strong>@Model.TotalBills</strong>
            </div>

        </div>


        <div class="ad-stat">

            <div class="ad-stat-icon orange">
                <i class="bi bi-exclamation-circle"></i>
            </div>

            <div>
                <span>UNPAID BILLS</span>
                <strong>@Model.UnpaidBills</strong>
            </div>

        </div>


        <div class="ad-stat">

            <div class="ad-stat-icon green">
                <i class="bi bi-check-circle"></i>
            </div>

            <div>
                <span>PAID BILLS</span>
                <strong>@Model.PaidBills</strong>
            </div>

        </div>


        <div class="ad-stat">

            <div class="ad-stat-icon orange">
                <i class="bi bi-clock-history"></i>
            </div>

            <div>
                <span>PAYMENTS TO VERIFY</span>
                <strong>@Model.PendingPayments</strong>
            </div>

        </div>


        <div class="ad-stat">

            <div class="ad-stat-icon green">
                <i class="bi bi-cash-stack"></i>
            </div>

            <div>
                <span>TODAY COLLECTION</span>
                <strong>Rs. @Model.TodayCollection.ToString("N0")</strong>
            </div>

        </div>

    </div>


    <div class="ad-finance-grid">

        <div class="ad-finance-card">

            <div class="ad-finance-icon orange">
                <i class="bi bi-wallet"></i>
            </div>

            <div>
                <span>OUTSTANDING AMOUNT</span>

                <strong>
                    Rs. @Model.OutstandingAmount.ToString("N0")
                </strong>

                <small>
                    Unpaid and partially paid bills
                </small>
            </div>

        </div>


        <div class="ad-finance-card">

            <div class="ad-finance-icon green">
                <i class="bi bi-graph-up-arrow"></i>
            </div>

            <div>
                <span>TOTAL VERIFIED COLLECTION</span>

                <strong>
                    Rs. @Model.TotalCollected.ToString("N0")
                </strong>

                <small>
                    Successfully verified payments
                </small>
            </div>

        </div>

    </div>


    <div class="ad-section">

        <div class="ad-section-header">

            <div>
                <h5>
                    <i class="bi bi-receipt-cutoff"></i>
                    Billing Pending
                </h5>

                <span>
                    Connections waiting for bill generation
                </span>
            </div>

            <a asp-controller="AccountsBill"
               asp-action="Pending">

                View All
                <i class="bi bi-arrow-right"></i>

            </a>

        </div>


        @if (Model.BillingPendingConnections.Any())
        {
            <div class="ad-table-wrap">

                <table class="ad-table">

                    <thead>
                        <tr>
                            <th>ACCOUNT</th>
                            <th>CUSTOMER</th>
                            <th>CONNECTION</th>
                            <th>PLAN</th>
                            <th>STATUS</th>
                            <th>ACTION</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var connection in
                            Model.BillingPendingConnections)
                        {
                            <tr>

                                <td>
                                    <strong class="ad-highlight">
                                        @connection.AccountId
                                    </strong>
                                </td>

                                <td>
                                    <div class="ad-person">
                                        <strong>
                                            @(connection.Customer?.FullName ?? "-")
                                        </strong>

                                        <span>
                                            @(connection.Customer?.Phone ?? "-")
                                        </span>
                                    </div>
                                </td>

                                <td>
                                    @connection.ConnectionType
                                </td>

                                <td>
                                    <div class="ad-person">
                                        <strong>
                                            @(connection.Plan?.PlanName ?? "-")
                                        </strong>

                                        <span>
                                            @(connection.Plan?.Speed ?? "-")
                                        </span>
                                    </div>
                                </td>

                                <td>
                                    <span class="ad-status pending">
                                        <i class="bi bi-circle-fill"></i>
                                        @(connection.Order?.Status ?? "-")
                                    </span>
                                </td>

                                <td>
                                    <a asp-controller="AccountsBill"
                                       asp-action="Create"
                                       asp-route-connectionId="@connection.ConnectionId"
                                       class="ad-action">

                                        Generate Bill

                                    </a>
                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="ad-empty">
                <i class="bi bi-check2-circle"></i>
                <h5>Billing Queue Clear</h5>
                <p>No connections are waiting for billing.</p>
            </div>
        }

    </div>


    <div class="ad-two-column">

        <div class="ad-section">

            <div class="ad-section-header">

                <div>
                    <h5>
                        <i class="bi bi-receipt"></i>
                        Recent Bills
                    </h5>

                    <span>Latest generated bills</span>
                </div>

                <a asp-controller="AccountsBill"
                   asp-action="Index">
                    View All
                </a>

            </div>


            @if (Model.RecentBills.Any())
            {
                <div class="ad-mini-list">

                    @foreach (var bill in Model.RecentBills)
                    {
                        <a asp-controller="AccountsBill"
                           asp-action="Details"
                           asp-route-id="@bill.BillId"
                           class="ad-mini-item">

                            <div class="ad-mini-icon">
                                <i class="bi bi-receipt"></i>
                            </div>

                            <div class="ad-mini-info">
                                <strong>
                                    @bill.BillNumber
                                </strong>

                                <span>
                                    @(bill.Customer?.FullName ?? "-")
                                </span>
                            </div>

                            <div class="ad-mini-right">

                                <strong>
                                    Rs. @bill.TotalAmount.ToString("N0")
                                </strong>

                                <span class="@(bill.Status == "Paid" ? "green" : "orange")">
                                    @bill.Status
                                </span>

                            </div>

                        </a>
                    }

                </div>
            }
            else
            {
                <div class="ad-small-empty">
                    No bills generated yet.
                </div>
            }

        </div>


        <div class="ad-section">

            <div class="ad-section-header">

                <div>
                    <h5>
                        <i class="bi bi-credit-card"></i>
                        Recent Payments
                    </h5>

                    <span>Latest payment activity</span>
                </div>

                <a asp-controller="AccountsPayment"
                   asp-action="Index">
                    View All
                </a>

            </div>


            @if (Model.RecentPayments.Any())
            {
                <div class="ad-mini-list">

                    @foreach (var payment in Model.RecentPayments)
                    {
                        <a asp-controller="AccountsPayment"
                           asp-action="Details"
                           asp-route-id="@payment.PaymentId"
                           class="ad-mini-item">

                            <div class="ad-mini-icon">
                                <i class="bi bi-cash"></i>
                            </div>

                            <div class="ad-mini-info">

                                <strong>
                                    @payment.PaymentNumber
                                </strong>

                                <span>
                                    @(payment.Customer?.FullName ?? "-")
                                </span>

                            </div>

                            <div class="ad-mini-right">

                                <strong>
                                    Rs. @payment.Amount.ToString("N0")
                                </strong>

                                <span class="@(payment.Status == "Paid" ? "green" : "orange")">
                                    @payment.Status
                                </span>

                            </div>

                        </a>
                    }

                </div>
            }
            else
            {
                <div class="ad-small-empty">
                    No payments recorded yet.
                </div>
            }

        </div>

    </div>

</div>