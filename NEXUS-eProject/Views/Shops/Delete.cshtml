@model NEXUS_eProject.Models.Shop

@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";

    ViewData["Title"] = "Delete Shop";
    ViewData["PageTitle"] = "Delete Shop";
    ViewData["PageSubtitle"] = "Remove shop from Nexus";
}

<div class="page-heading">

    <div>
        <h2>Delete Shop</h2>
        <p>Review the shop before deleting it.</p>
    </div>

    <a asp-action="Index"
       class="btn btn-outline-secondary">

        <i class="bi bi-arrow-left"></i>
        Back

    </a>

</div>


<div class="delete-card">

    <div class="delete-icon">
        <i class="bi bi-trash3"></i>
    </div>


    <h4>Delete this shop?</h4>

    <p>
        Are you sure you want to permanently delete
        <strong>@Model.ShopName</strong>?
    </p>


    <div class="delete-details">

        <div>
            <span>Shop ID</span>
            <strong>#@Model.ShopId</strong>
        </div>

        <div>
            <span>City</span>
            <strong>@Model.City</strong>
        </div>

        <div>
            <span>Contact</span>
            <strong>@(Model.ContactNumber ?? "N/A")</strong>
        </div>

    </div>


    <form asp-action="Delete"
          asp-route-id="@Model.ShopId"
          method="post">

        <div class="form-footer">

            <a asp-action="Index"
               class="btn btn-outline-secondary">

                Cancel

            </a>

            <button type="submit"
                    class="btn btn-danger">

                <i class="bi bi-trash3"></i>
                Delete Shop

            </button>

        </div>

    </form>

</div>