@{
    ViewData["Title"] = "About Us";
    Layout = "_PublicLayout";
}

<!-- =========================================================
     ABOUT HERO
========================================================= -->

<section class="about-hero">

    <div class="about-hero-grid"></div>

    <div class="container">

        <div class="about-hero-content">

            <span class="about-eyebrow">
                <i class="bi bi-broadcast-pin"></i>
                ABOUT NEXUS
            </span>

            <h1>
                Connecting People.
                <span>Powering Possibilities.</span>
            </h1>

            <p>
                NEXUS is a connectivity service provider focused on
                delivering reliable internet and telephone solutions
                for homes, businesses and communities.
            </p>

            <div class="about-hero-actions">

                <a asp-controller="Home"
                   asp-action="Services"
                   class="btn-nexus-primary">
                    Explore Our Services
                    <i class="bi bi-arrow-right"></i>
                </a>

                <a asp-controller="Home"
                   asp-action="Contact"
                   class="btn-nexus-outline">
                    Contact Us
                </a>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     INTRODUCTION
========================================================= -->

<section class="about-intro nexus-section">

    <div class="container">

        <div class="row align-items-center g-5">

            <div class="col-lg-6">

                <div class="about-image-wrapper">

                    <div class="about-image-glow"></div>

                    <img src="https://images.unsplash.com/photo-1451187580459-43490279c0fa?auto=format&fit=crop&w=1200&q=85"
                         alt="Global network connectivity"
                         class="about-main-image" />

                    <div class="about-floating-card">

                        <div class="about-floating-icon">
                            <i class="bi bi-globe2"></i>
                        </div>

                        <div>
                            <strong>Stay Connected</strong>
                            <span>Wherever you need us</span>
                        </div>

                    </div>

                </div>

            </div>


            <div class="col-lg-6">

                <div class="about-content">

                    <span class="section-eyebrow">
                        WHO WE ARE
                    </span>

                    <h2>
                        Built around
                        <span>connectivity.</span>
                    </h2>

                    <p class="about-lead">
                        At NEXUS, our goal is simple — make communication
                        and connectivity accessible through dependable
                        services and a clear customer-focused process.
                    </p>

                    <p>
                        Our services include Dial-Up Internet, Broadband
                        Internet and Telephone / Landline solutions.
                        From submitting an application to technical
                        feasibility and connection activation, NEXUS
                        follows a structured process designed to keep
                        every step organized.
                    </p>

                    <div class="about-check-list">

                        <div class="about-check-item">
                            <i class="bi bi-check-circle-fill"></i>
                            <span>Reliable connectivity solutions</span>
                        </div>

                        <div class="about-check-item">
                            <i class="bi bi-check-circle-fill"></i>
                            <span>Structured service process</span>
                        </div>

                        <div class="about-check-item">
                            <i class="bi bi-check-circle-fill"></i>
                            <span>Technical feasibility before activation</span>
                        </div>

                        <div class="about-check-item">
                            <i class="bi bi-check-circle-fill"></i>
                            <span>Customer-focused service experience</span>
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     OUR SERVICES
========================================================= -->

<section class="about-services nexus-section">

    <div class="container">

        <div class="section-heading text-center">

            <span class="section-eyebrow">
                WHAT WE PROVIDE
            </span>

            <h2>
                Connectivity for
                <span>every need.</span>
            </h2>

            <p>
                Choose the service that fits your connectivity and
                communication requirements.
            </p>

        </div>


        <div class="row g-4 mt-4">

            <!-- Broadband -->

            <div class="col-lg-4 col-md-6">

                <div class="about-service-card">

                    <div class="about-service-image">

                        <img src="https://images.unsplash.com/photo-1558494949-ef010cbdcc31?auto=format&fit=crop&w=900&q=85"
                             alt="Broadband Internet" />

                        <div class="about-service-icon">
                            <i class="bi bi-wifi"></i>
                        </div>

                    </div>

                    <div class="about-service-body">

                        <span class="about-service-number">
                            01
                        </span>

                        <h3>Broadband Internet</h3>

                        <p>
                            High-speed internet connectivity designed
                            for everyday browsing, work, entertainment
                            and connected devices.
                        </p>

                        <a asp-controller="Home"
                           asp-action="Services">
                            Learn More
                            <i class="bi bi-arrow-right"></i>
                        </a>

                    </div>

                </div>

            </div>


            <!-- Dial-Up -->

            <div class="col-lg-4 col-md-6">

                <div class="about-service-card">

                    <div class="about-service-image">

                        <img src="https://images.unsplash.com/photo-1544197150-b99a580bb7a8?auto=format&fit=crop&w=900&q=85"
                             alt="Dial-Up Internet" />

                        <div class="about-service-icon">
                            <i class="bi bi-router"></i>
                        </div>

                    </div>

                    <div class="about-service-body">

                        <span class="about-service-number">
                            02
                        </span>

                        <h3>Dial-Up Internet</h3>

                        <p>
                            A traditional internet connectivity option
                            available as part of the NEXUS service
                            portfolio.
                        </p>

                        <a asp-controller="Home"
                           asp-action="Services">
                            Learn More
                            <i class="bi bi-arrow-right"></i>
                        </a>

                    </div>

                </div>

            </div>


            <!-- Telephone -->

            <div class="col-lg-4 col-md-6">

                <div class="about-service-card">

                    <div class="about-service-image">

                        <img src="https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&w=900&q=85"
                             alt="Telephone and Landline" />

                        <div class="about-service-icon">
                            <i class="bi bi-telephone"></i>
                        </div>

                    </div>

                    <div class="about-service-body">

                        <span class="about-service-number">
                            03
                        </span>

                        <h3>Telephone / Landline</h3>

                        <p>
                            Telephone and landline services for
                            dependable voice communication and
                            everyday connectivity.
                        </p>

                        <a asp-controller="Home"
                           asp-action="Services">
                            Learn More
                            <i class="bi bi-arrow-right"></i>
                        </a>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     HOW NEXUS WORKS
========================================================= -->

<section class="about-process nexus-section">

    <div class="container">

        <div class="row align-items-end mb-5">

            <div class="col-lg-7">

                <span class="section-eyebrow">
                    OUR PROCESS
                </span>

                <h2>
                    From application to
                    <span>connection.</span>
                </h2>

            </div>

            <div class="col-lg-5">

                <p class="section-description">
                    NEXUS follows a structured workflow to process
                    applications, check technical feasibility and
                    activate connections.
                </p>

            </div>

        </div>


        <div class="about-process-line"></div>


        <div class="row g-4">

            <!-- Step 01 -->

            <div class="col-lg-3 col-md-6">

                <div class="about-step-card">

                    <div class="about-step-number">
                        01
                    </div>

                    <div class="about-step-icon">
                        <i class="bi bi-file-earmark-text"></i>
                    </div>

                    <h3>Application</h3>

                    <p>
                        Submit your customer and service information
                        to begin the connection process.
                    </p>

                </div>

            </div>


            <!-- Step 02 -->

            <div class="col-lg-3 col-md-6">

                <div class="about-step-card">

                    <div class="about-step-number">
                        02
                    </div>

                    <div class="about-step-icon">
                        <i class="bi bi-search"></i>
                    </div>

                    <h3>Feasibility</h3>

                    <p>
                        Technical staff checks the area, server,
                        infrastructure and required distance.
                    </p>

                </div>

            </div>


            <!-- Step 03 -->

            <div class="col-lg-3 col-md-6">

                <div class="about-step-card">

                    <div class="about-step-number">
                        03
                    </div>

                    <div class="about-step-icon">
                        <i class="bi bi-router"></i>
                    </div>

                    <h3>Installation</h3>

                    <p>
                        Once the area is technically approved,
                        the connection and required equipment are
                        prepared.
                    </p>

                </div>

            </div>


            <!-- Step 04 -->

            <div class="col-lg-3 col-md-6">

                <div class="about-step-card">

                    <div class="about-step-number">
                        04
                    </div>

                    <div class="about-step-icon">
                        <i class="bi bi-lightning-charge"></i>
                    </div>

                    <h3>Activation</h3>

                    <p>
                        The connection is completed and activated
                        for the customer.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     WHY NEXUS
========================================================= -->

<section class="about-values nexus-section">

    <div class="container">

        <div class="about-values-box">

            <div class="row align-items-center g-5">

                <div class="col-lg-5">

                    <span class="section-eyebrow">
                        WHY NEXUS
                    </span>

                    <h2>
                        More than just
                        <span>a connection.</span>
                    </h2>

                    <p>
                        Our approach combines connectivity services
                        with an organized workflow that keeps customers
                        informed throughout the service journey.
                    </p>

                    <a asp-controller="Home"
                       asp-action="Contact"
                       class="btn-nexus-primary">
                        Get In Touch
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>


                <div class="col-lg-7">

                    <div class="row g-3">

                        <div class="col-md-6">

                            <div class="about-value-card">

                                <div class="about-value-icon">
                                    <i class="bi bi-shield-check"></i>
                                </div>

                                <h4>Reliable Service</h4>

                                <p>
                                    Connectivity solutions designed
                                    around dependable service delivery.
                                </p>

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="about-value-card">

                                <div class="about-value-icon">
                                    <i class="bi bi-diagram-3"></i>
                                </div>

                                <h4>Structured Process</h4>

                                <p>
                                    A clear workflow from application
                                    through technical feasibility.
                                </p>

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="about-value-card">

                                <div class="about-value-icon">
                                    <i class="bi bi-headset"></i>
                                </div>

                                <h4>Customer Focus</h4>

                                <p>
                                    Services and processes designed
                                    around customer requirements.
                                </p>

                            </div>

                        </div>


                        <div class="col-md-6">

                            <div class="about-value-card">

                                <div class="about-value-icon">
                                    <i class="bi bi-cpu"></i>
                                </div>

                                <h4>Technical Approach</h4>

                                <p>
                                    Technical checks help determine
                                    whether a connection can be provided.
                                </p>

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     FINAL CTA
========================================================= -->

<section class="about-final-cta">

    <div class="about-cta-grid"></div>

    <div class="container">

        <div class="about-cta-content">

            <span class="section-eyebrow">
                READY TO CONNECT?
            </span>

            <h2>
                Let's build your
                <span>connection.</span>
            </h2>

            <p>
                Explore our services and find the connectivity
                solution that works for you.
            </p>

            <div class="about-cta-actions">

                <a asp-controller="Home"
                   asp-action="Services"
                   class="btn-nexus-primary">
                    Explore Services
                    <i class="bi bi-arrow-right"></i>
                </a>

                <a asp-controller="Home"
                   asp-action="Contact"
                   class="btn-nexus-outline">
                    Contact NEXUS
                </a>

            </div>

        </div>

    </div>

</section>