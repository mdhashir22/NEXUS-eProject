@{
    ViewData["Title"] = "Services";
    Layout = "_PublicLayout";
}

<!-- =========================================================
     SERVICES HERO
========================================================= -->

<section class="services-hero">

    <div class="services-hero-grid"></div>

    <div class="container">

        <div class="services-hero-content">

            <span class="services-eyebrow">
                <i class="bi bi-broadcast"></i>
                NEXUS SERVICES
            </span>

            <h1>
                Connectivity
                <span>Built Around You.</span>
            </h1>

            <p>
                Explore NEXUS connectivity and communication services
                designed for different customer requirements, from
                internet access to telephone and landline services.
            </p>

            <div class="services-hero-actions">

                <a href="#service-details"
                   class="btn-nexus-primary">
                    Explore Services
                    <i class="bi bi-arrow-down"></i>
                </a>

                <a asp-controller="Home"
                   asp-action="Contact"
                   class="btn-nexus-outline">
                    Talk To Us
                </a>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     SERVICE OVERVIEW
========================================================= -->

<section class="services-overview nexus-section"
         id="service-details">

    <div class="container">

        <div class="section-heading text-center">

            <span class="section-eyebrow">
                OUR CORE SERVICES
            </span>

            <h2>
                Choose your
                <span>connection.</span>
            </h2>

            <p>
                NEXUS provides internet and telephone services
                through a structured service and activation process.
            </p>

        </div>


        <div class="row g-4 mt-4">

            <!-- Broadband -->

            <div class="col-lg-4 col-md-6">

                <a href="#broadband"
                   class="service-overview-card">

                    <div class="service-overview-number">
                        01
                    </div>

                    <div class="service-overview-icon">
                        <i class="bi bi-wifi"></i>
                    </div>

                    <h3>Broadband Internet</h3>

                    <p>
                        Internet connectivity for everyday browsing,
                        work, entertainment and connected devices.
                    </p>

                    <span class="service-overview-link">
                        View Service
                        <i class="bi bi-arrow-right"></i>
                    </span>

                </a>

            </div>


            <!-- Dial Up -->

            <div class="col-lg-4 col-md-6">

                <a href="#dialup"
                   class="service-overview-card">

                    <div class="service-overview-number">
                        02
                    </div>

                    <div class="service-overview-icon">
                        <i class="bi bi-router"></i>
                    </div>

                    <h3>Dial-Up Internet</h3>

                    <p>
                        A traditional internet connectivity option
                        included in the NEXUS service portfolio.
                    </p>

                    <span class="service-overview-link">
                        View Service
                        <i class="bi bi-arrow-right"></i>
                    </span>

                </a>

            </div>


            <!-- Telephone -->

            <div class="col-lg-4 col-md-6">

                <a href="#telephone"
                   class="service-overview-card">

                    <div class="service-overview-number">
                        03
                    </div>

                    <div class="service-overview-icon">
                        <i class="bi bi-telephone"></i>
                    </div>

                    <h3>Telephone / Landline</h3>

                    <p>
                        Reliable telephone and landline communication
                        for everyday voice connectivity.
                    </p>

                    <span class="service-overview-link">
                        View Service
                        <i class="bi bi-arrow-right"></i>
                    </span>

                </a>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     BROADBAND SERVICE
========================================================= -->

<section class="service-detail-section"
         id="broadband">

    <div class="container">

        <div class="row align-items-center g-5">

            <div class="col-lg-6">

                <div class="service-detail-image">

                    <img src="https://images.unsplash.com/photo-1558494949-ef010cbdcc31?auto=format&fit=crop&w=1400&q=85"
                         alt="Broadband Internet" />

                    <div class="service-image-overlay"></div>

                    <div class="service-floating-status">

                        <span class="status-dot"></span>

                        <span>
                            Broadband Connectivity
                        </span>

                    </div>

                </div>

            </div>


            <div class="col-lg-6">

                <div class="service-detail-content">

                    <span class="service-detail-label">
                        SERVICE 01
                    </span>

                    <h2>
                        Broadband
                        <span>Internet</span>
                    </h2>

                    <p class="service-detail-lead">
                        A practical internet connectivity solution
                        for customers who need dependable access for
                        their everyday digital activities.
                    </p>

                    <p>
                        Broadband connectivity can support browsing,
                        online work, entertainment, communication and
                        connected devices. Service availability is
                        determined through the technical feasibility
                        process.
                    </p>

                    <div class="service-feature-grid">

                        <div class="service-feature">
                            <i class="bi bi-globe2"></i>
                            <span>Internet Connectivity</span>
                        </div>

                        <div class="service-feature">
                            <i class="bi bi-speedometer2"></i>
                            <span>Multiple Plan Options</span>
                        </div>

                        <div class="service-feature">
                            <i class="bi bi-router"></i>
                            <span>Equipment Support</span>
                        </div>

                        <div class="service-feature">
                            <i class="bi bi-headset"></i>
                            <span>Customer Assistance</span>
                        </div>

                    </div>

                    <a asp-controller="Home"
                       asp-action="Plans"
                       class="btn-nexus-primary service-detail-button">
                        View Internet Plans
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     DIAL-UP SERVICE
========================================================= -->

<section class="service-detail-section service-detail-reverse"
         id="dialup">

    <div class="container">

        <div class="row align-items-center g-5">

            <div class="col-lg-6 order-lg-2">

                <div class="service-detail-image">

                    <img src="https://images.unsplash.com/photo-1544197150-b99a580bb7a8?auto=format&fit=crop&w=1400&q=85"
                         alt="Dial-Up Internet" />

                    <div class="service-image-overlay"></div>

                    <div class="service-floating-status">

                        <span class="status-dot purple"></span>

                        <span>
                            Dial-Up Service
                        </span>

                    </div>

                </div>

            </div>


            <div class="col-lg-6 order-lg-1">

                <div class="service-detail-content">

                    <span class="service-detail-label purple-label">
                        SERVICE 02
                    </span>

                    <h2>
                        Dial-Up
                        <span>Internet</span>
                    </h2>

                    <p class="service-detail-lead">
                        A traditional internet access option available
                        within the NEXUS connectivity portfolio.
                    </p>

                    <p>
                        Dial-Up provides an alternative connectivity
                        option for customers whose requirements are
                        suited to this type of internet service.
                    </p>

                    <div class="service-feature-grid">

                        <div class="service-feature">
                            <i class="bi bi-router"></i>
                            <span>Internet Access</span>
                        </div>

                        <div class="service-feature">
                            <i class="bi bi-diagram-3"></i>
                            <span>Connection Processing</span>
                        </div>

                        <div class="service-feature">
                            <i class="bi bi-clipboard-check"></i>
                            <span>Technical Feasibility</span>
                        </div>

                        <div class="service-feature">
                            <i class="bi bi-person-check"></i>
                            <span>Customer Support</span>
                        </div>

                    </div>

                    <a asp-controller="Home"
                       asp-action="Contact"
                       class="btn-nexus-primary service-detail-button">
                        Ask About Dial-Up
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     TELEPHONE SERVICE
========================================================= -->

<section class="service-detail-section"
         id="telephone">

    <div class="container">

        <div class="row align-items-center g-5">

            <div class="col-lg-6">

                <div class="service-detail-image">

                    <img src="https://images.unsplash.com/photo-1516321318423-f06f85e504b3?auto=format&fit=crop&w=1400&q=85"
                         alt="Telephone and Landline" />

                    <div class="service-image-overlay"></div>

                    <div class="service-floating-status">

                        <span class="status-dot"></span>

                        <span>
                            Telephone / Landline
                        </span>

                    </div>

                </div>

            </div>


            <div class="col-lg-6">

                <div class="service-detail-content">

                    <span class="service-detail-label">
                        SERVICE 03
                    </span>

                    <h2>
                        Telephone /
                        <span>Landline</span>
                    </h2>

                    <p class="service-detail-lead">
                        Voice communication services designed to
                        provide dependable telephone connectivity.
                    </p>

                    <p>
                        NEXUS Telephone / Landline services provide
                        customers with a dedicated communication
                        option for everyday voice requirements.
                    </p>

                    <div class="service-feature-grid">

                        <div class="service-feature">
                            <i class="bi bi-telephone"></i>
                            <span>Voice Communication</span>
                        </div>

                        <div class="service-feature">
                            <i class="bi bi-telephone-outbound"></i>
                            <span>Telephone Service</span>
                        </div>

                        <div class="service-feature">
                            <i class="bi bi-gear"></i>
                            <span>Service Processing</span>
                        </div>

                        <div class="service-feature">
                            <i class="bi bi-headset"></i>
                            <span>Customer Assistance</span>
                        </div>

                    </div>

                    <a asp-controller="Home"
                       asp-action="Contact"
                       class="btn-nexus-primary service-detail-button">
                        Contact NEXUS
                        <i class="bi bi-arrow-right"></i>
                    </a>

                </div>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     SERVICE PROCESS
========================================================= -->

<section class="services-process nexus-section">

    <div class="container">

        <div class="section-heading text-center">

            <span class="section-eyebrow">
                SIMPLE PROCESS
            </span>

            <h2>
                Get connected in
                <span>four steps.</span>
            </h2>

            <p>
                Every service request follows a structured workflow
                before the connection is activated.
            </p>

        </div>


        <div class="services-timeline">

            <div class="services-timeline-line"></div>


            <div class="service-process-item">

                <div class="service-process-number">
                    01
                </div>

                <div class="service-process-icon">
                    <i class="bi bi-file-earmark-plus"></i>
                </div>

                <h3>Apply</h3>

                <p>
                    Submit your customer and service information.
                </p>

            </div>


            <div class="service-process-item">

                <div class="service-process-number">
                    02
                </div>

                <div class="service-process-icon">
                    <i class="bi bi-search"></i>
                </div>

                <h3>Feasibility</h3>

                <p>
                    Technical staff checks service availability
                    for the required area.
                </p>

            </div>


            <div class="service-process-item">

                <div class="service-process-number">
                    03
                </div>

                <div class="service-process-icon">
                    <i class="bi bi-tools"></i>
                </div>

                <h3>Installation</h3>

                <p>
                    Required connection equipment and installation
                    are arranged.
                </p>

            </div>


            <div class="service-process-item">

                <div class="service-process-number">
                    04
                </div>

                <div class="service-process-icon">
                    <i class="bi bi-check2-circle"></i>
                </div>

                <h3>Activate</h3>

                <p>
                    The approved connection is completed and
                    activated.
                </p>

            </div>

        </div>

    </div>

</section>


<!-- =========================================================
     SERVICE CTA
========================================================= -->

<section class="services-final-cta">

    <div class="services-cta-glow"></div>

    <div class="container">

        <div class="services-final-content">

            <span class="section-eyebrow">
                FIND YOUR CONNECTION
            </span>

            <h2>
                Ready to connect
                <span>with NEXUS?</span>
            </h2>

            <p>
                Explore available plans or contact our team to
                discuss your connectivity requirements.
            </p>

            <div class="services-final-actions">

                <a asp-controller="Home"
                   asp-action="Plans"
                   class="btn-nexus-primary">
                    Explore Plans
                    <i class="bi bi-arrow-right"></i>
                </a>

                <a asp-controller="Home"
                   asp-action="Contact"
                   class="btn-nexus-outline">
                    Contact Us
                </a>

            </div>

        </div>

    </div>

</section>