@model IEnumerable<NEXUS_eProject.Models.Connection>

@{
    ViewData["Title"] = "Equipment Assignments";
    ViewData["PageTitle"] = "Equipment Assignments";
    Layout = "~/Views/Shared/_TechnicalLayout.cshtml";

    var search = ViewBag.Search as string;
}

<div class="tea-page">

    <div class="te-header">

        <div>
            <span>
                <i class="bi bi-diagram-3"></i>
                TECHNICAL EQUIPMENT
            </span>

            <h2>Equipment Assignments</h2>

            <p>
                Equipment and router serials currently assigned
                to customer connections.
            </p>
        </div>

        <div class="tea-count">

            <span>ASSIGNMENTS</span>

            <strong>
                @Model.Count()
            </strong>

        </div>

    </div>


    <div class="te-filter-card">

        <form method="get"
              asp-controller="TechnicalEquipment"
              asp-action="Assignments"
              class="te-filter">

            <div class="te-search">

                <i class="bi bi-search"></i>

                <input type="text"
                       name="search"
                       value="@search"
                       placeholder="Search account, customer, equipment or serial..." />

            </div>

            <button type="submit">
                <i class="bi bi-search"></i>
                Search
            </button>

        </form>

    </div>


    <div class="te-card">

        <div class="te-card-header">

            <div>
                <h5>
                    <i class="bi bi-diagram-3"></i>
                    Assignment Records
                </h5>

                <span>
                    @Model.Count() assignment(s) found
                </span>
            </div>

        </div>


        @if (Model.Any())
        {
            <div class="te-table-wrap">

                <table class="te-table">

                    <thead>
                        <tr>
                            <th>ACCOUNT</th>
                            <th>CUSTOMER</th>
                            <th>EQUIPMENT</th>
                            <th>SERIAL</th>
                            <th>CONNECTION</th>
                            <th>STATUS</th>
                            <th>ACTION</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            var active =
                                item.Status == "Active";

                            <tr>

                                <td>
                                    <strong class="tea-account">
                                        @item.AccountId
                                    </strong>
                                </td>


                                <td>

                                    <div class="te-customer">

                                        <strong>
                                            @(item.Customer?.FullName ?? "-")
                                        </strong>

                                        <span>
                                            @(item.Customer?.Phone ?? "-")
                                        </span>

                                    </div>

                                </td>


                                <td>
                                    @(string.IsNullOrWhiteSpace(
                                        item.Equipment)
                                        ? "-"
                                        : item.Equipment)
                                </td>


                                <td>

                                    <span class="tea-serial">

                                        @(string.IsNullOrWhiteSpace(
                                            item.RouterSerial)
                                            ? "-"
                                            : item.RouterSerial)

                                    </span>

                                </td>


                                <td>
                                    @item.ConnectionType
                                </td>


                                <td>

                                    <span class="te-stock @(active ? "available" : "pending")">

                                        <i class="bi bi-circle-fill"></i>

                                        @(item.Status ?? "Pending")

                                    </span>

                                </td>


                                <td>

                                    <a asp-controller="TechnicalConnection"
                                       asp-action="Details"
                                       asp-route-id="@item.ConnectionId"
                                       class="tea-view">

                                        <i class="bi bi-eye"></i>

                                    </a>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="te-empty">

                <i class="bi bi-diagram-3"></i>

                <h5>No Assignments Found</h5>

                <p>
                    Equipment assignments will appear after
                    equipment is linked with connections.
                </p>

            </div>
        }

    </div>

</div>